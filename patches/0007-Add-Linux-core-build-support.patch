Subject: [PATCH 7/8] Add Linux core build support


diff --git a/src/3rdparty/javascriptcore/JavaScriptCore/wtf/qt/ThreadingQt.cpp b/src/3rdparty/javascriptcore/JavaScriptCore/wtf/qt/ThreadingQt.cpp
index 71de552..1a78801 100644
--- a/src/3rdparty/javascriptcore/JavaScriptCore/wtf/qt/ThreadingQt.cpp
+++ b/src/3rdparty/javascriptcore/JavaScriptCore/wtf/qt/ThreadingQt.cpp
@@ -36,6 +36,8 @@
 #include "MainThread.h"
 #include "RandomNumberSeed.h"
 
+#include <climits>
+
 #include <QtCore/qcoreapplication.h>
 #include <QtCore/qmutex.h>
 #include <QtCore/qthread.h>
diff --git a/src/script/CMakeLists.txt b/src/script/CMakeLists.txt
index c6848e3..fcda78b 100644
--- a/src/script/CMakeLists.txt
+++ b/src/script/CMakeLists.txt
@@ -38,9 +38,8 @@ set(parser_sources
     parser/qscriptsyntaxchecker.cpp
 )
 
-# Windows x64/MSVC interpreter source set. JIT, ARM, POSIX, Symbian and other
-# preprocessor-empty translation units from the legacy qmake manifest are
-# intentionally omitted.
+# Interpreter-only source set. JIT, ARM, Symbian, and other inactive
+# translation units from the legacy qmake manifest are omitted.
 set(jsc_sources
     "${jsc_dir}/API/JSBase.cpp"
     "${jsc_dir}/API/JSCallbackConstructor.cpp"
@@ -121,7 +120,6 @@ set(jsc_sources
     "${jsc_dir}/runtime/JSWrapperObject.cpp"
     "${jsc_dir}/runtime/LiteralParser.cpp"
     "${jsc_dir}/runtime/Lookup.cpp"
-    "${jsc_dir}/runtime/MarkStackWin.cpp"
     "${jsc_dir}/runtime/MarkStack.cpp"
     "${jsc_dir}/runtime/MathObject.cpp"
     "${jsc_dir}/runtime/NativeErrorConstructor.cpp"
@@ -252,8 +250,6 @@ qt_internal_add_module(Script
         ENABLE_JIT=0
         ENABLE_YARR_JIT=0
         ENABLE_YARR=0
-        NOMINMAX
-        _CRT_RAND_S
     INCLUDE_DIRECTORIES
         "${CMAKE_CURRENT_SOURCE_DIR}"
         "${CMAKE_CURRENT_SOURCE_DIR}/parser"
@@ -280,14 +276,29 @@ qt_internal_add_module(Script
         "${jsc_dir}/yarr"
     LIBRARIES
         Qt::CorePrivate
-        winmm
     PUBLIC_LIBRARIES
         Qt::Core
     PRIVATE_MODULE_INTERFACE
         Qt::CorePrivate
 )
 
+qt_internal_extend_target(Script CONDITION WIN32
+    SOURCES
+        "${jsc_dir}/runtime/MarkStackWin.cpp"
+    DEFINES
+        NOMINMAX
+    LIBRARIES
+        winmm
+)
+
+qt_internal_extend_target(Script CONDITION UNIX
+    SOURCES
+        "${jsc_dir}/runtime/MarkStackPosix.cpp"
+)
+
 qt_internal_extend_target(Script CONDITION MSVC
+    DEFINES
+        _CRT_RAND_S
     COMPILE_OPTIONS
         /wd4099
         /wd4291
