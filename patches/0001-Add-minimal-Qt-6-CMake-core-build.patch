From f2b2ba2e3ae3c39da79092c39b2957f7698c1430 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Fri, 7 Aug 2026 00:25:28 +0200
Subject: [PATCH 1/7] Add minimal Qt 6 CMake core build

---
 .cmake.conf               |   7 +
 CMakeLists.txt            |  16 ++
 src/CMakeLists.txt        |   1 +
 src/script/CMakeLists.txt | 301 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 325 insertions(+)
 create mode 100644 .cmake.conf
 create mode 100644 CMakeLists.txt
 create mode 100644 src/CMakeLists.txt
 create mode 100644 src/script/CMakeLists.txt

diff --git a/.cmake.conf b/.cmake.conf
new file mode 100644
index 0000000..4d70241
--- /dev/null
+++ b/.cmake.conf
@@ -0,0 +1,7 @@
+if(NOT DEFINED QT_REPO_MODULE_VERSION)
+    set(QT_REPO_MODULE_VERSION "6.8.3")
+endif()
+set(QT_REPO_MODULE_PRERELEASE_VERSION_SEGMENT "")
+
+list(APPEND QT_EXTRA_INTERNAL_TARGET_DEFINES "QT_NO_FOREACH=1")
+list(APPEND QT_EXTRA_INTERNAL_TARGET_DEFINES "QT_NO_JAVA_STYLE_ITERATORS=1")
diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..d50991e
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,16 @@
+cmake_minimum_required(VERSION 3.16)
+
+include(.cmake.conf)
+project(QtScript
+    VERSION "${QT_REPO_MODULE_VERSION}"
+    DESCRIPTION "Legacy Qt Script compatibility module"
+    HOMEPAGE_URL "https://www.qt.io/"
+    LANGUAGES C CXX
+)
+
+find_package(Qt6 ${PROJECT_VERSION} CONFIG REQUIRED
+    COMPONENTS BuildInternals Core Core5Compat
+)
+qt_internal_project_setup()
+
+qt_build_repo()
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
new file mode 100644
index 0000000..a98c7fc
--- /dev/null
+++ b/src/CMakeLists.txt
@@ -0,0 +1 @@
+add_subdirectory(script)
