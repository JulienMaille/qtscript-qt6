From 1e5c19251992dc2b8a4f3d5d2f907ad9d1eb4600 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Tue, 11 Aug 2026 19:06:10 +0200
Subject: [PATCH] Defer QObject destruction until after QuickJS GC

---
 src/script/quickjs/qscriptenginequickjs.cpp  | 11 +++++++++++
 src/script/quickjs/qscriptqobjectquickjs.cpp |  5 +++++
 src/script/quickjs/qscriptquickjs_p.h        |  3 +++
 3 files changed, 19 insertions(+)

diff --git a/src/script/quickjs/qscriptenginequickjs.cpp b/src/script/quickjs/qscriptenginequickjs.cpp
index b07bbbc..268cc81 100644
--- a/src/script/quickjs/qscriptenginequickjs.cpp
+++ b/src/script/quickjs/qscriptenginequickjs.cpp
@@ -755,6 +755,16 @@ QScriptEngineState::~QScriptEngineState()
         JS_FreeRuntime(runtime);
         runtime = nullptr;
     }
+    deleteDeferredQObjects();
+}
+
+void QScriptEngineState::deleteDeferredQObjects()
+{
+    while (!deferredQObjectDeletes.isEmpty()) {
+        const QPointer<QObject> object = deferredQObjectDeletes.takeFirst();
+        if (object)
+            delete object;
+    }
 }
 
 void QScriptEngineState::clearException()
@@ -1852,6 +1862,7 @@ void QScriptEngine::collectGarbage()
 {
     Q_D(QScriptEngine);
     JS_RunGC(d->state->runtime);
+    d->state->deleteDeferredQObjects();
 }
 
 void QScriptEngine::reportAdditionalMemoryCost(int) {}
diff --git a/src/script/quickjs/qscriptqobjectquickjs.cpp b/src/script/quickjs/qscriptqobjectquickjs.cpp
index 3b817de..c1006f2 100644
--- a/src/script/quickjs/qscriptqobjectquickjs.cpp
+++ b/src/script/quickjs/qscriptqobjectquickjs.cpp
@@ -126,6 +126,11 @@ void qobjectFinalizer(JSRuntime *, JSValueConst value)
         }
     }
     delete payload;
+    if (scriptOwns && state) {
+        if (!state->deferredQObjectDeletes.contains(object))
+            state->deferredQObjectDeletes.append(object);
+        return;
+    }
     if (scriptOwns)
         delete object;
 }
diff --git a/src/script/quickjs/qscriptquickjs_p.h b/src/script/quickjs/qscriptquickjs_p.h
index d8e5612..d851bce 100644
--- a/src/script/quickjs/qscriptquickjs_p.h
+++ b/src/script/quickjs/qscriptquickjs_p.h
@@ -86,6 +86,8 @@ public:
     QScriptEngineState();
     ~QScriptEngineState();
 
+    void deleteDeferredQObjects();
+
     JSRuntime *runtime = nullptr;
     JSContext *context = nullptr;
     QPointer<QScriptEngine> engine;
@@ -111,6 +113,7 @@ public:
     QHash<int, QScriptTypeInfo> typeInfos;
     QHash<int, QScriptValue> defaultPrototypes;
     QHash<QObject *, QList<QScriptQObjectWrapper>> qobjectWrappers;
+    QList<QPointer<QObject>> deferredQObjectDeletes;
     QList<QScriptClassObjectData *> scriptClassObjects;
     QList<QScriptSignalConnection> signalConnections;
     QSet<QObject *> signalCleanupSenders;
