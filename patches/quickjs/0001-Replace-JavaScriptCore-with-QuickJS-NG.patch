+
+void QScriptEngine::setGlobalObject(const QScriptValue &object)
+{
+    Q_D(QScriptEngine);
+    bool ok = false;
+    JSValue source = d->toQuickJS(object, &ok);
+    if (!ok || !JS_IsObject(source)) {
+        JS_FreeValue(d->state->context, source);
+        return;
+    }
+    JSValue global = JS_GetGlobalObject(d->state->context);
+    JSPropertyEnum *properties = nullptr;
+    uint32_t count = 0;
+    if (JS_GetOwnPropertyNames(d->state->context, &properties, &count, source,
+                               JS_GPN_STRING_MASK | JS_GPN_SYMBOL_MASK) == 0) {
+        for (uint32_t index = 0; index < count; ++index) {
+            JSValue value = JS_GetProperty(d->state->context, source, properties[index].atom);
+            if (!JS_IsException(value))
+                JS_SetProperty(d->state->context, global, properties[index].atom, value);
+        }
+        JS_FreePropertyEnum(d->state->context, properties, count);
+    }
+    JS_FreeValue(d->state->context, global);
+    JS_FreeValue(d->state->context, source);
+}
