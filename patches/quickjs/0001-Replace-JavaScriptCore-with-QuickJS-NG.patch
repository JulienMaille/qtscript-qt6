+bool QScriptContext::isCalledAsConstructor() const
+{
+    return d_ptr && d_ptr->calledAsConstructor;
+}
+
+QScriptValue QScriptContext::throwValue(const QScriptValue &value)
+{
+    if (!d_ptr || !d_ptr->engine)
+        return invalidValue();
+    QScriptEnginePrivate *engine = QScriptEnginePrivate::get(d_ptr->engine);
+    bool ok = false;
+    JSValue materialized = engine ? engine->toQuickJS(value, &ok) : JS_UNDEFINED;
+    if (!ok)
+        return invalidValue();
+    engine->state->rememberException(JS_DupValue(engine->state->context, materialized));
+    JS_FreeValue(engine->state->context, materialized);
+    d_ptr->thrownValue = value;
+    d_ptr->state = ExceptionState;
+    return value;
+}
+
+QScriptValue QScriptContext::throwError(Error error, const QString &text)
+{
+    if (!d_ptr || !d_ptr->engine)
+        return invalidValue();
+    QScriptEnginePrivate *engine = QScriptEnginePrivate::get(d_ptr->engine);
+    if (!engine || !engine->state || !engine->state->context)
+        return invalidValue();
+    const QByteArray utf8 = text.toUtf8();
+    JSValue result = JS_UNDEFINED;
+    switch (error) {
+    case ReferenceError: result = JS_NewReferenceError(engine->state->context, "%s", utf8.constData()); break;
+    case SyntaxError: result = JS_NewSyntaxError(engine->state->context, "%s", utf8.constData()); break;
+    case TypeError: result = JS_NewTypeError(engine->state->context, "%s", utf8.constData()); break;
+    case RangeError: result = JS_NewRangeError(engine->state->context, "%s", utf8.constData()); break;
+    case URIError:
+        result = JS_NewError(engine->state->context);
+        JS_DefinePropertyValueStr(engine->state->context, result, "name",
+                                  JS_NewString(engine->state->context, "URIError"),
+                                  JS_PROP_C_W_E);
+        JS_DefinePropertyValueStr(engine->state->context, result, "message",
+                                  JS_NewStringLen(engine->state->context, utf8.constData(),
+                                                  size_t(utf8.size())),
+                                  JS_PROP_C_W_E);
+        break;
+    case UnknownError: result = JS_NewError(engine->state->context); break;
+    }
+    if (error == UnknownError)
+        JS_DefinePropertyValueStr(engine->state->context, result, "message",
+                                  JS_NewStringLen(engine->state->context, utf8.constData(),
+                                                  size_t(utf8.size())),
+                                  JS_PROP_C_W_E);
+    QScriptValue thrown = engine->fromOwned(result);
+    return throwValue(thrown);
+}
+
+QScriptValue QScriptContext::throwError(const QString &text)
+{
+    return throwError(UnknownError, text);
+}
+
+QStringList QScriptContext::backtrace() const
+{
+    if (!d_ptr)
+        return QStringList();
+    QStringList result;
+    for (const QScriptContext *context = this; context; context = context->parentContext())
+        result.append(context->toString());
+    return result;
+}
+
+QString QScriptContext::toString() const
+{
+    if (!d_ptr)
+        return QString();
+    QString result = contextFunctionName(d_ptr);
+    result += QLatin1Char('(');
+    for (int index = 0; index < d_ptr->arguments.size(); ++index) {
+        if (index)
+            result += QStringLiteral(", ");
+        const QScriptValue argumentValue = d_ptr->arguments.at(index);
+        if (argumentValue.isString())
+            result += QLatin1Char('\'');
+        result += argumentValue.toString();
+        if (argumentValue.isString())
+            result += QLatin1Char('\'');
+    }
+    result += QStringLiteral(") at : -1");
+    return result;
+}
