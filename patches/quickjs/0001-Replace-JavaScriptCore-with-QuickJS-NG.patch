+QScriptValue QScriptEngine::importExtension(const QString &extension)
+{
+    Q_D(QScriptEngine);
+    if (d->state->importedExtensions.contains(extension))
+        return undefinedValue();
+    for (const QString &libraryPath : QCoreApplication::libraryPaths()) {
+        QDir directory(QDir(libraryPath).filePath(QStringLiteral("script")));
+        for (const QString &fileName : directory.entryList(QDir::Files)) {
+            auto loader = QSharedPointer<QPluginLoader>::create(directory.filePath(fileName));
+            QObject *instance = loader->instance();
+            auto *interface = qobject_cast<QScriptExtensionInterface *>(instance);
+            if (!interface || !interface->keys().contains(extension))
+                continue;
+            interface->initialize(extension, this);
+            d->state->pluginLoaders.append(loader);
+            d->state->importedExtensions.append(extension);
+            return undefinedValue();
+        }
+    }
+    return newError(this, QScriptContext::UnknownError,
+                    QStringLiteral("Unable to import QtScript extension %1").arg(extension));
+}
+
+QStringList QScriptEngine::availableExtensions() const
+{
+    QStringList result;
+    for (const QString &libraryPath : QCoreApplication::libraryPaths()) {
+        QDir directory(QDir(libraryPath).filePath(QStringLiteral("script")));
+        for (const QString &fileName : directory.entryList(QDir::Files)) {
+            QPluginLoader loader(directory.filePath(fileName));
+            QObject *instance = loader.instance();
+            if (auto *interface = qobject_cast<QScriptExtensionInterface *>(instance))
+                result.append(interface->keys());
+        }
+    }
+    result.removeDuplicates();
+    return result;
+}
