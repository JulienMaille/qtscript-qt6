+QScriptContext *QScriptEngine::pushContext()
+{
+    Q_D(QScriptEngine);
+    QScriptContext *context = createEngineContext(this, d->state->currentContext,
+                                                  globalObject(), true);
+    d->state->currentContext = context;
+    if (d->state->agent)
+        d->state->agent->contextPush();
+    return context;
+}
+
+void QScriptEngine::popContext()
+{
+    Q_D(QScriptEngine);
+    QScriptContext *context = d->state->currentContext;
+    if (!context || !QScriptContextPrivate::get(context)->parent) {
+        qWarning("QScriptEngine::popContext() doesn't match with pushContext()");
+        return;
+    }
+    d->state->currentContext = QScriptContextPrivate::get(context)->parent;
+    if (d->state->agent)
+        d->state->agent->contextPop();
+    delete context;
+}
+
+bool QScriptEngine::canEvaluate(const QString &program) const
+{
+    return checkSyntax(program).state() != QScriptSyntaxCheckResult::Intermediate;
+}
+
+QScriptSyntaxCheckResult QScriptEngine::checkSyntax(const QString &program)
+{
+    QScriptSyntaxCheckResult result;
+    result.d_ptr = new QScriptSyntaxCheckResultPrivate;
+    JSRuntime *runtime = JS_NewRuntime();
+    JSContext *context = runtime ? JS_NewContext(runtime) : nullptr;
+    if (!context) {
+        result.d_ptr->state = QScriptSyntaxCheckResult::Error;
+        result.d_ptr->message = QStringLiteral("Unable to create QuickJS context");
+        if (runtime)
+            JS_FreeRuntime(runtime);
+        return result;
+    }
+    const QByteArray source = program.toUtf8();
+    JSValue compiled = JS_Eval(context, source.constData(), size_t(source.size()),
+                               "<syntax-check>", JS_EVAL_TYPE_GLOBAL | JS_EVAL_FLAG_COMPILE_ONLY);
+    if (JS_IsException(compiled)) {
+        JSValue exception = JS_GetException(context);
+        result.d_ptr->message = qScriptQuickJSString(context, exception);
+        const QString lower = result.d_ptr->message.toLower();
+        result.d_ptr->state = lower.contains(QStringLiteral("unexpected end"))
+                || lower.contains(QStringLiteral("unterminated"))
+            ? QScriptSyntaxCheckResult::Intermediate : QScriptSyntaxCheckResult::Error;
+        JS_FreeValue(context, exception);
+    } else {
+        JS_FreeValue(context, compiled);
+    }
+    JS_FreeContext(context);
+    JS_FreeRuntime(runtime);
+    return result;
+}
