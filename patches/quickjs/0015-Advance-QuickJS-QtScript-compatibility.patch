From 349b4637a9cef4c593f4329e0967e20372977da0 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Wed, 12 Aug 2026 01:29:40 +0200
Subject: [PATCH] Advance QuickJS QtScript compatibility

---
 src/script/quickjs/qscriptenginequickjs.cpp   | 60 +++++++++++++++++--
 src/script/quickjs/qscriptquickjs_p.h         |  5 ++
 .../quickjs/qscriptvalueiteratorquickjs.cpp   |  2 +-
 src/script/quickjs/qscriptvaluequickjs.cpp    | 11 ++++
 4 files changed, 73 insertions(+), 5 deletions(-)

diff --git a/src/script/quickjs/qscriptenginequickjs.cpp b/src/script/quickjs/qscriptenginequickjs.cpp
index 565a950..876c7a9 100644
--- a/src/script/quickjs/qscriptenginequickjs.cpp
+++ b/src/script/quickjs/qscriptenginequickjs.cpp
@@ -887,8 +887,14 @@ int interruptHandler(JSRuntime *, void *opaque)
     auto *state = static_cast<QScriptEngineState *>(opaque);
     if (!state)
         return 0;
-    if (state->abortRequested)
+    if (state->abortRequested) {
+        if (state->abortValueIsError && state->hasException) {
+            JSValue exception = JS_DupValue(state->context, state->exception);
+            JS_SetUncatchableError(state->context, exception);
+            JS_Throw(state->context, exception);
+        }
         return 1;
+    }
 
     const qint64 now = QDateTime::currentMSecsSinceEpoch();
     if (state->evaluationDeadline > 0 && now >= state->evaluationDeadline)
@@ -1223,6 +1229,7 @@ JSValue nativeFunctionThunk(JSContext *context, JSValueConst, int argc,
         result = contextPrivate->returnValue;
 
     const bool threw = contextPrivate->state == QScriptContext::ExceptionState;
+    state->lastNativeReturnInvalid = !threw && !result.isValid();
     QScriptValue thrownValue = contextPrivate->thrownValue;
     if (state->agent)
         state->agent->contextPop();
@@ -1239,6 +1246,18 @@ JSValue nativeFunctionThunk(JSContext *context, JSValueConst, int argc,
         quickResult = JS_UNDEFINED;
     if (threw)
         return JS_Throw(context, quickResult);
+    if (state->abortRequested) {
+        JS_FreeValue(context, quickResult);
+        if (state->abortValueIsError && state->abortValueSet) {
+            JSValue exception = JS_DupValue(context, state->abortValue);
+            JS_SetUncatchableError(context, exception);
+            return JS_Throw(context, exception);
+        }
+        JSValue interrupted = JS_NewInternalError(context, "interrupted");
+        if (!JS_IsException(interrupted))
+            JS_SetUncatchableError(context, interrupted);
+        return JS_Throw(context, interrupted);
+    }
     return quickResult;
 }
 
@@ -1727,6 +1746,7 @@ void QScriptEngineState::shutdown()
             JS_FreeAtom(context, symbolHasInstanceAtom);
             symbolHasInstanceAtom = JS_ATOM_NULL;
         }
+        clearAbortValue();
         clearException();
         JS_SetContextOpaque(context, nullptr);
         JS_FreeContext(context);
@@ -1769,6 +1789,15 @@ void QScriptEngineState::rememberException(JSValue exceptionValue, int lineNumbe
     setExceptionLocation(context, exception, exceptionLine, stackInfo.fileName);
 }
 
+void QScriptEngineState::clearAbortValue()
+{
+    if (context && abortValueSet)
+        JS_FreeValue(context, abortValue);
+    abortValue = JS_UNDEFINED;
+    abortValueSet = false;
+    abortValueIsError = false;
+}
+
 QScriptEnginePrivate::QScriptEnginePrivate()
     : state(new QScriptEngineState)
 {
@@ -2452,6 +2481,7 @@ QScriptValue QScriptEngine::evaluate(const QString &program, const QString &file
     Q_D(QScriptEngine);
     QScriptEngineState *state = d->state.data();
     state->clearException();
+    state->clearAbortValue();
     state->abortRequested = false;
     d->syncGlobalObjectToRuntime();
     JS_UpdateStackTop(state->runtime);
@@ -2794,7 +2824,16 @@ QScriptValue QScriptEngine::evaluate(const QString &program, const QString &file
     d->syncRuntimeGlobalObject();
 
     QScriptValue result;
-    if (JS_IsException(value)) {
+    if (state->abortRequested) {
+        if (JS_IsException(value))
+            JS_FreeValue(state->context, JS_GetException(state->context));
+        if (state->abortValueSet)
+            result = d->fromBorrowed(state->abortValue);
+        else
+            result = QScriptValue();
+        if (!state->abortValueIsError)
+            state->clearException();
+    } else if (JS_IsException(value)) {
         JSValue exception = JS_GetException(state->context);
         const bool isRememberedException = state->hasException
             && JS_IsStrictEqual(state->context, exception, state->exception);
@@ -2873,10 +2912,23 @@ bool QScriptEngine::isEvaluating() const
     return d->state->evaluating;
 }
 
-void QScriptEngine::abortEvaluation(const QScriptValue &)
+void QScriptEngine::abortEvaluation(const QScriptValue &value)
 {
     Q_D(QScriptEngine);
-    d->state->abortRequested = true;
+    QScriptEngineState *state = d->state.data();
+    state->abortRequested = true;
+    state->clearAbortValue();
+    if (!value.isValid())
+        return;
+    bool conversionOk = false;
+    JSValue abortValue = d->toQuickJS(value, &conversionOk);
+    if (!conversionOk)
+        return;
+    state->abortValue = abortValue;
+    state->abortValueSet = true;
+    state->abortValueIsError = JS_IsError(abortValue);
+    if (state->abortValueIsError)
+        state->rememberException(JS_DupValue(state->context, abortValue));
 }
 
 bool QScriptEngine::hasUncaughtException() const
diff --git a/src/script/quickjs/qscriptquickjs_p.h b/src/script/quickjs/qscriptquickjs_p.h
index 5c09545..19a0be3 100644
--- a/src/script/quickjs/qscriptquickjs_p.h
+++ b/src/script/quickjs/qscriptquickjs_p.h
@@ -103,6 +103,10 @@ public:
 
     bool evaluating = false;
     bool abortRequested = false;
+    JSValue abortValue = JS_UNDEFINED;
+    bool abortValueSet = false;
+    bool abortValueIsError = false;
+    bool lastNativeReturnInvalid = false;
     bool destroying = false;
     qint64 evaluationDeadline = 0;
     bool hasException = false;
@@ -139,6 +143,7 @@ public:
     bool customGlobalObject = false;
 
     void clearException();
+    void clearAbortValue();
     void rememberException(JSValue exceptionValue, int lineNumber = -1);
 };
 
diff --git a/src/script/quickjs/qscriptvalueiteratorquickjs.cpp b/src/script/quickjs/qscriptvalueiteratorquickjs.cpp
index d43cc2a..1aa848c 100644
--- a/src/script/quickjs/qscriptvalueiteratorquickjs.cpp
+++ b/src/script/quickjs/qscriptvalueiteratorquickjs.cpp
@@ -61,7 +61,7 @@ public:
                 JSValue name = JS_AtomToString(context, properties[index].atom);
                 if (!JS_IsException(name)) {
                     const QString propertyName = qScriptQuickJSString(context, name);
-                    bool skip = false;
+                    bool skip = propertyName == QLatin1String("__qtscript_static_scope__");
                     if (!propertyName.contains(QLatin1Char('('))) {
                         const QScriptValue property = objectValue.property(
                             propertyName, QScriptValue::ResolveLocal);
diff --git a/src/script/quickjs/qscriptvaluequickjs.cpp b/src/script/quickjs/qscriptvaluequickjs.cpp
index 0accbcf..fed1d77 100644
--- a/src/script/quickjs/qscriptvaluequickjs.cpp
+++ b/src/script/quickjs/qscriptvaluequickjs.cpp
@@ -659,6 +659,7 @@ static QScriptValue callWithArguments(QScriptValuePrivate *privateValue,
     if (state->agent)
         state->agent->contextPush();
 
+    state->lastNativeReturnInvalid = false;
     JSValue result = JS_UNDEFINED;
     if (construct) {
         result = JS_CallConstructor(context, function, arguments.size(), arguments.data());
@@ -687,6 +688,7 @@ static QScriptValue callWithArguments(QScriptValuePrivate *privateValue,
     JS_FreeValue(context, function);
 
     if (JS_IsException(result)) {
+        state->lastNativeReturnInvalid = false;
         QScriptValue exception = exceptionValue(engine);
         if (previousContext) {
             QScriptContextPrivate *previousPrivate = QScriptContextPrivate::get(previousContext);
@@ -697,6 +699,11 @@ static QScriptValue callWithArguments(QScriptValuePrivate *privateValue,
         }
         return exception;
     }
+    if (state->lastNativeReturnInvalid) {
+        state->lastNativeReturnInvalid = false;
+        JS_FreeValue(context, result);
+        return invalidValue();
+    }
     return engine->fromOwned(result);
 }
 
@@ -2372,6 +2379,10 @@ void QScriptContext::pushScope(const QScriptValue &object)
         return;
     }
     d_ptr->scopes.prepend(object);
+    if (d_ptr->engine && d_ptr->scopes.size() > 1
+        && d_ptr->activationObject.strictlyEquals(d_ptr->scopes.at(1))
+        && !d_ptr->activationObject.strictlyEquals(d_ptr->engine->globalObject()))
+        d_ptr->activationObject = object;
 }
 
 QScriptValue QScriptContext::popScope()
