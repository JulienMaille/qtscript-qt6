From be2e24eabd1769c7b2c65c4ed1b49b5e91a4ad72 Mon Sep 17 00:00:00 2001
From: codex <codex@local.invalid>
Date: Wed, 12 Aug 2026 12:53:09 +0200
Subject: [PATCH] Drop legacy QuickJS error-message normalization

---
 src/script/quickjs/qscriptenginequickjs.cpp | 130 --------------------
 src/script/quickjs/qscriptvaluequickjs.cpp  |  15 ---
 2 files changed, 145 deletions(-)

diff --git a/src/script/quickjs/qscriptenginequickjs.cpp b/src/script/quickjs/qscriptenginequickjs.cpp
index 7764961..ec423dd 100644
--- a/src/script/quickjs/qscriptenginequickjs.cpp
+++ b/src/script/quickjs/qscriptenginequickjs.cpp
@@ -1562,135 +1562,6 @@ static void setExceptionLocation(JSContext *context, JSValueConst exception,
     }
 }
 
-static JSValue normalizeNonCallableError(JSContext *context,
-                                         QScriptEnginePrivate *engine,
-                                         JSValue exception,
-                                         const QByteArray &source)
-{
-    if (!context || !engine || !JS_IsError(exception))
-        return exception;
-
-    JSValue messageValue = JS_GetPropertyStr(context, exception, "message");
-    const QString message = JS_IsException(messageValue)
-        ? QString() : qScriptQuickJSString(context, messageValue);
-    JS_FreeValue(context, messageValue);
-    if (message == QStringLiteral("Maximum call stack size exceeded")) {
-        const QByteArray normalized =
-            QByteArrayLiteral("Maximum call stack size exceeded.");
-        if (JS_SetPropertyStr(context, exception, "message",
-                              JS_NewStringLen(context, normalized.constData(),
-                                              size_t(normalized.size()))) < 0)
-            discardQuickJSException(context);
-        return exception;
-    }
-    if (message == QStringLiteral("circular prototype chain")) {
-        JSValue normalized = JS_NewError(context);
-        JS_SetPropertyStr(context, normalized, "message",
-                          JS_NewString(context, "cyclic __proto__ value"));
-        JS_FreeValue(context, exception);
-        return normalized;
-    }
-    static const QRegularExpression undefinedVariablePattern(
-        QStringLiteral("^(.+) is not defined$"));
-    const QRegularExpressionMatch undefinedVariableMatch =
-        undefinedVariablePattern.match(message);
-    if (undefinedVariableMatch.hasMatch()) {
-        const QString normalized = QStringLiteral("Can't find variable: %1")
-            .arg(undefinedVariableMatch.captured(1));
-        const QByteArray normalizedUtf8 = normalized.toUtf8();
-        if (JS_SetPropertyStr(context, exception, "message",
-                              JS_NewStringLen(context, normalizedUtf8.constData(),
-                                              size_t(normalizedUtf8.size()))) < 0)
-            discardQuickJSException(context);
-        return exception;
-    }
-    if (message.startsWith(QStringLiteral("cannot read property '"))
-        && message.endsWith(QStringLiteral("' of undefined"))) {
-        QString expression = QString::fromUtf8(source).trimmed();
-        const int separator = qMax(expression.lastIndexOf(QLatin1Char(';')),
-                                   expression.lastIndexOf(QLatin1Char('\n')));
-        if (separator >= 0)
-            expression = expression.mid(separator + 1).trimmed();
-        static const QRegularExpression propertyPattern(
-            QStringLiteral("^([A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*)\\.[A-Za-z_$][A-Za-z0-9_$]*$"));
-        const QRegularExpressionMatch propertyMatch = propertyPattern.match(expression);
-        if (propertyMatch.hasMatch()) {
-            const QString operandExpression = propertyMatch.captured(1);
-            const QByteArray expressionUtf8 = operandExpression.toUtf8();
-            JSValue operand = JS_Eval(context, expressionUtf8.constData(),
-                                      size_t(expressionUtf8.size()),
-                                      "<qtscript-error-expression>", JS_EVAL_TYPE_GLOBAL);
-            if (!JS_IsException(operand)) {
-                QScriptValue operandValue = engine->fromOwned(operand);
-                QString display;
-                if (operandValue.isUndefined())
-                    display = QStringLiteral("undefined");
-                else if (operandValue.isNull())
-                    display = QStringLiteral("null");
-                else if (operandValue.isQObject())
-                    display = QString();
-                else
-                    display = operandValue.toString();
-                const QString normalized =
-                    QStringLiteral("Result of expression '%1' [%2] is not an object.")
-                    .arg(operandExpression, display);
-                const QByteArray normalizedUtf8 = normalized.toUtf8();
-                if (JS_SetPropertyStr(context, exception, "message",
-                                      JS_NewStringLen(context, normalizedUtf8.constData(),
-                                                      size_t(normalizedUtf8.size()))) < 0)
-                    discardQuickJSException(context);
-            }
-        }
-    }
-    const bool notFunction = message == QStringLiteral("not a function");
-    const bool constructorSyntax = QString::fromUtf8(source).trimmed()
-        .startsWith(QStringLiteral("new "));
-    const bool notConstructor = message == QStringLiteral("not a constructor")
-        || (notFunction && constructorSyntax);
-    if (!notFunction && !notConstructor)
-        return exception;
-
-    QString expression = QString::fromUtf8(source).trimmed();
-    if (expression.endsWith(QLatin1Char(';')))
-        expression.chop(1);
-    expression = expression.trimmed();
-    if (notConstructor && expression.startsWith(QStringLiteral("new ")))
-        expression.remove(0, 4);
-    const int openingParen = expression.lastIndexOf(QLatin1Char('('));
-    if (openingParen <= 0 || !expression.endsWith(QLatin1Char(')')))
-        return exception;
-    expression.truncate(openingParen);
-    expression = expression.trimmed();
-    static const QRegularExpression expressionPattern(
-        QStringLiteral("^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"));
-    if (!expressionPattern.match(expression).hasMatch())
-        return exception;
-
-    const QByteArray expressionUtf8 = expression.toUtf8();
-    JSValue operand = JS_Eval(context, expressionUtf8.constData(), size_t(expressionUtf8.size()),
-                              "<qtscript-error-expression>", JS_EVAL_TYPE_GLOBAL);
-    if (JS_IsException(operand))
-        return exception;
-    QScriptValue operandValue = engine->fromOwned(operand);
-    QString display;
-    if (operandValue.isUndefined())
-        display = QStringLiteral("undefined");
-    else if (operandValue.isNull())
-        display = QStringLiteral("null");
-    else if (operandValue.isQObject())
-        display = QString();
-    else
-        display = operandValue.toString();
-
-    const QString normalized = QStringLiteral("Result of expression '%1' [%2] is not a %3.")
-        .arg(expression, display, notConstructor ? QStringLiteral("constructor")
-                                                 : QStringLiteral("function"));
-    const QByteArray normalizedUtf8 = normalized.toUtf8();
-    JSValue result = JS_NewTypeError(context, "%s", normalizedUtf8.constData());
-    JS_FreeValue(context, exception);
-    return result;
-}
-
 QScriptValue newError(QScriptEngine *engine, QScriptContext::Error error, const QString &text)
 {
     const char *constructor = "Error";
@@ -3189,7 +3060,6 @@ QScriptValue QScriptEngine::evaluate(const QString &program, const QString &file
         } else {
             if (state->hasException)
                 state->clearException();
-            exception = normalizeNonCallableError(state->context, d, exception, source);
             state->rememberException(exception);
             if (state->exceptionLine < 0 && lineNumber >= 0) {
                 state->exceptionLine = lineNumber;
diff --git a/src/script/quickjs/qscriptvaluequickjs.cpp b/src/script/quickjs/qscriptvaluequickjs.cpp
index 10b40b5..32d704b 100644
--- a/src/script/quickjs/qscriptvaluequickjs.cpp
+++ b/src/script/quickjs/qscriptvaluequickjs.cpp
@@ -1251,21 +1251,6 @@ QString QScriptValue::toString() const
         QString exceptionText = JS_IsError(exception)
             ? errorObjectString(context, exception)
             : qScriptQuickJSString(context, exception);
-        if (exceptionText == QStringLiteral("TypeError: not a function")
-            && JS_IsObject(value->value)) {
-            // JSC reports the actual incompatible built-in when a function
-            // prototype is used as an object's [[Prototype]]. QuickJS emits
-            // its generic call error for the same legacy QtScript case.
-            JSValue prototype = JS_GetPrototype(context, value->value);
-            const bool functionPrototype = !JS_IsException(prototype)
-                && JS_IsFunction(context, prototype);
-            JS_FreeValue(context, prototype);
-            if (JS_HasException(context))
-                discardException(context);
-            if (functionPrototype)
-                exceptionText = QStringLiteral(
-                    "TypeError: Function.prototype.toString called on incompatible object");
-        }
         discardException(context);
         value->state->rememberException(exception);
         return exceptionText;
-- 
