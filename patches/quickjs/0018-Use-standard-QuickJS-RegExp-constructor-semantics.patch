From f674184db481d40068c09eecbb956b2222a818d5 Mon Sep 17 00:00:00 2001
From: codex <codex@local.invalid>
Date: Wed, 12 Aug 2026 13:04:00 +0200
Subject: [PATCH] Use standard QuickJS RegExp constructor semantics

---
 src/script/quickjs/qscriptenginequickjs.cpp | 17 -----------------
 1 file changed, 17 deletions(-)

diff --git a/src/script/quickjs/qscriptenginequickjs.cpp b/src/script/quickjs/qscriptenginequickjs.cpp
index ec423dd..a8f2f90 100644
--- a/src/script/quickjs/qscriptenginequickjs.cpp
+++ b/src/script/quickjs/qscriptenginequickjs.cpp
@@ -446,24 +446,7 @@ static void installQtScriptLegacyAccessorHelpers(QScriptEngineState *state)
     Object.defineProperty(Function.prototype, "disconnect", {
         configurable: true, writable: true, value: disconnect
     });
-    var globalObject = this;
-    var qtOriginalRegExp = globalObject.RegExp;
-    function legacyRegExp(pattern, flags) {
-        if (pattern instanceof qtOriginalRegExp && arguments.length > 1)
-            throw new TypeError("Cannot supply flags when constructing one RegExp from another");
-        if (arguments.length === 0)
-            return qtOriginalRegExp();
-        if (arguments.length === 1)
-            return qtOriginalRegExp(pattern);
-        return qtOriginalRegExp(pattern, flags);
-    }
-    legacyRegExp.prototype = qtOriginalRegExp.prototype;
-    Object.setPrototypeOf(legacyRegExp, qtOriginalRegExp);
-    globalObject.RegExp = legacyRegExp;
     try {
-        Object.defineProperty(legacyRegExp, "name", {
-            configurable: true, value: "RegExp"
-        });
         Object.defineProperty(Object.prototype.__defineGetter__, "name", {
             configurable: true, value: "__defineGetter__"
         });
-- 
