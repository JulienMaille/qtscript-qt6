From b207e01cd0c6f226122d8f80815f18580b65b693 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Mon, 31 Aug 2026 22:23:41 +0200
Subject: [PATCH 1/2] Yield non-enumerable own properties from
 QScriptValueIterator

The QuickJS iterator filtered out non-enumerable properties via
JS_GetOwnPropertyNames' is_enumerable flag. That broke QtScript's
documented QScriptValueIterator contract, which enumerates every own
property and reports the SkipInEnumeration bit through flags().

Array and string instances expose a non-enumerable 'length' property,
and users can mark arbitrary properties with QScriptValue::SkipInEnumeration;
all of these must still be visited by the iterator. The tests rely on
this: tst_QScriptValueIterator::iterateArray/iterateString iterate
'length', iterateBackAndForth/remove visit SkipInEnumeration properties.

Drop the is_enumerable filter; propertyFlagsFromDescriptor already maps
the QuickJS enumerable bit to QScriptValue::SkipInEnumeration, so the
reported flags stay correct.
---
 src/script/quickjs/qscriptvalueiteratorquickjs.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/script/quickjs/qscriptvalueiteratorquickjs.cpp b/src/script/quickjs/qscriptvalueiteratorquickjs.cpp
index d4f6159..14730a7 100644
--- a/src/script/quickjs/qscriptvalueiteratorquickjs.cpp
+++ b/src/script/quickjs/qscriptvalueiteratorquickjs.cpp
@@ -58,8 +58,7 @@ public:
                                    JS_GPN_STRING_MASK) >= 0) {
             propertyNames.reserve(int(count));
             for (uint32_t index = 0; index < count; ++index) {
-                if (!properties[index].is_enumerable)
-                    continue;
+
                 JSValue name = JS_AtomToString(context, properties[index].atom);
                 if (!JS_IsException(name)) {
                     const QString propertyName = qScriptQuickJSString(context, name);
