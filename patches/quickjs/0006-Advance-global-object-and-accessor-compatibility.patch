+
+static void removeMissingGlobalProperties(QScriptEngineState *state,
+                                           JSValueConst target,
+                                           const QStringList &previous,
+                                           const QStringList &current)
+{
+    for (const QString &name : previous) {
+        if (current.contains(name))
