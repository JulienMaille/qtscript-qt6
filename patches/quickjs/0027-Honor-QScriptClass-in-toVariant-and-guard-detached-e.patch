From 82e0f28501684108a8a2ac3869dc3c860a9a9058 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript@example.com>
Date: Mon, 31 Aug 2026 23:12:51 +0200
Subject: [PATCH 2/2] Honor QScriptClass in toVariant and guard detached equals

toVariant() skipped the QScriptClass override when a registered value type
was present, returning the raw payload instead of the script class result.
Skip direct payload extraction when a QScriptClass is set, matching
isVariant() and variantFromObjectImpl().

Also guard QScriptValue::equals() against a detached (null state) left
operand before dereferencing state->customGlobalObject, mirroring
strictlyEquals().
---
 src/script/quickjs/qscriptvaluequickjs.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/script/quickjs/qscriptvaluequickjs.cpp b/src/script/quickjs/qscriptvaluequickjs.cpp
index 642141a..bb03899 100644
--- a/src/script/quickjs/qscriptvaluequickjs.cpp
+++ b/src/script/quickjs/qscriptvaluequickjs.cpp
@@ -1360,7 +1360,7 @@ QVariant QScriptValue::toVariant() const
     // re-enter toVariant(), which is both unnecessary and can deadlock while
     // a generated overload is checking the value's QMetaType (QSqlDatabase
     // and QSqlQuery are prominent examples).
-    if (JS_IsObject(value->value)) {
+    if (JS_IsObject(value->value) && !qScriptQuickJSScriptClass(*this)) {
         if (const QScriptVariantPayload *payload =
                 qscriptVariantPayload(value->state.data(), value->value)) {
             return payload->value;
@@ -1554,7 +1554,7 @@ bool QScriptValue::equals(const QScriptValue &other) const
         qWarning("QScriptValue::equals: cannot compare to a value created in a different engine");
         return false;
     }
-    if (leftPrivate->state->customGlobalObject) {
+    if (leftPrivate->state && leftPrivate->state->customGlobalObject) {
         const bool leftRuntime = JS_IsStrictEqual(leftPrivate->state->context,
                                                   leftPrivate->value,
                                                   leftPrivate->state->runtimeGlobal);
