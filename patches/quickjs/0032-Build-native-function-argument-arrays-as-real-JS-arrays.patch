From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Tue, 1 Sep 2026 00:53:31 +0200
Subject: [PATCH 5/7] Build native-function argument arrays as real JS arrays

---
 src/script/quickjs/qscriptvaluequickjs.cpp | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/src/script/quickjs/qscriptvaluequickjs.cpp b/src/script/quickjs/qscriptvaluequickjs.cpp
index bb03899..4e4b4f6 100644
--- a/src/script/quickjs/qscriptvaluequickjs.cpp
+++ b/src/script/quickjs/qscriptvaluequickjs.cpp
@@ -2387,10 +2387,7 @@ QScriptValue QScriptContext::argumentsObject() const
         return invalidValue();
     if (d_ptr->argumentsObjectCache.isValid())
         return d_ptr->argumentsObjectCache;
-    QScriptValue result = d_ptr->engine->newObject();
-    result.setProperty(QStringLiteral("length"), QScriptValue(d_ptr->engine,
-                                                               int(d_ptr->arguments.size())),
-                       QScriptValue::SkipInEnumeration);
+    QScriptValue result = d_ptr->engine->newArray(uint(d_ptr->arguments.size()));
     if (d_ptr->callee.isValid())
         result.setProperty(QStringLiteral("callee"), d_ptr->callee,
                            QScriptValue::SkipInEnumeration);
