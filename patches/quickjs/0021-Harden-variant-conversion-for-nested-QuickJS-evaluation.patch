From 6f35a70b45b94fdb4b929c42986722c4664ba999 Mon Sep 17 00:00:00 2001
From: Julien Maille <julien.maille@gmail.com>
Date: Sat, 15 Aug 2026 03:05:00 +0200
Subject: [PATCH] Harden variant conversion for nested QuickJS evaluation

Keep native QVariant payload extraction inside the QuickJS backend.  Direct
class opaque data and the private marker are inspected structurally, without
calling JavaScript getters or resolving inherited properties.  This prevents
native overload conversion from re-entering generated QObject/QScriptClass
bridges while an evaluation is already active.

Also use the common payload representation in object conversion and pointer
conversion so marker-backed wrappers behave like direct QVariant wrappers.

---
 src/script/quickjs/qscriptenginequickjs.cpp | 25 +-------
 src/script/quickjs/qscriptquickjs_p.h       |  6 ++
 src/script/quickjs/qscriptvaluequickjs.cpp  | 98 ++++++++++++++---------------
 3 files changed, 60 insertions(+), 72 deletions(-)

diff --git a/src/script/quickjs/qscriptenginequickjs.cpp b/src/script/quickjs/qscriptenginequickjs.cpp
index 2ff2c18..f3ac89b 100644
--- a/src/script/quickjs/qscriptenginequickjs.cpp
+++ b/src/script/quickjs/qscriptenginequickjs.cpp
@@ -771,10 +771,7 @@ constexpr char metaObjectProperty[] = "__qtscript_metaobject__";
 static QScriptVariantPayload *variantPayload(JSContext *context, JSValueConst value)
 {
     auto *state = static_cast<QScriptEngineState *>(JS_GetContextOpaque(context));
-    if (!state || !state->variantClassId || !JS_IsObject(value)
-        || JS_GetClassID(value) != state->variantClassId)
-        return nullptr;
-    return static_cast<QScriptVariantPayload *>(JS_GetOpaque(value, state->variantClassId));
+    return qscriptVariantPayload(state, value);
 }
 
 static JSValue variantValueOf(JSContext *context, JSValueConst thisObject, int, JSValueConst *)
@@ -2120,18 +2117,8 @@ bool QScriptEnginePrivate::toVariantType(const QScriptValue &value, QMetaType ty
         QScriptValuePrivate *valuePrivate = QScriptValuePrivate::get(value);
         if (valuePrivate && valuePrivate->state == state
             && valuePrivate->kind == QScriptValuePrivate::QuickJSValue) {
-            JSValue storedVariant = JS_UNDEFINED;
             JSValueConst variantObject = valuePrivate->value;
-            if (JS_GetClassID(variantObject) != state->variantClassId) {
-                storedVariant = JS_GetPropertyStr(state->context, variantObject,
-                                                  "__qtscript_variant__");
-                if (!JS_IsException(storedVariant))
-                    variantObject = storedVariant;
-            }
-            auto *payload = JS_GetClassID(variantObject) == state->variantClassId
-                ? static_cast<QScriptVariantPayload *>(
-                    JS_GetOpaque(variantObject, state->variantClassId))
-                : nullptr;
+            auto *payload = qscriptVariantPayload(state.data(), variantObject);
             bool convertedPointer = false;
             void *pointer = nullptr;
             if (payload) {
@@ -2206,14 +2193,6 @@ bool QScriptEnginePrivate::toVariantType(const QScriptValue &value, QMetaType ty
                     }
                 }
             }
-            if (!JS_IsUndefined(storedVariant)) {
-                if (JS_IsException(storedVariant)) {
-                    JSValue exception = JS_GetException(state->context);
-                    JS_FreeValue(state->context, exception);
-                } else {
-                    JS_FreeValue(state->context, storedVariant);
-                }
-            }
             if (convertedPointer) {
                 *static_cast<void **>(destination) = pointer;
                 return true;
diff --git a/src/script/quickjs/qscriptquickjs_p.h b/src/script/quickjs/qscriptquickjs_p.h
index 2e69226..47b686b 100644
--- a/src/script/quickjs/qscriptquickjs_p.h
+++ b/src/script/quickjs/qscriptquickjs_p.h
@@ -156,6 +156,12 @@ struct QScriptVariantPayload
     QVariant value;
 };
 
+// Return the native payload carried by a QtScript variant wrapper without
+// invoking JavaScript property getters or walking its prototype chain.  The
+// result is borrowed from the supplied object (or its own marker property).
+QScriptVariantPayload *qscriptVariantPayload(QScriptEngineState *state,
+                                              JSValueConst value);
+
 class QScriptValuePrivate : public QSharedData
 {
 public:
diff --git a/src/script/quickjs/qscriptvaluequickjs.cpp b/src/script/quickjs/qscriptvaluequickjs.cpp
index b660670..e1b02f0 100644
--- a/src/script/quickjs/qscriptvaluequickjs.cpp
+++ b/src/script/quickjs/qscriptvaluequickjs.cpp
@@ -26,7 +26,6 @@ namespace {
 
 constexpr char dataProperty[] = "__qt_data__";
 constexpr char scopeProperty[] = "__qt_scope__";
-constexpr char variantProperty[] = "__qtscript_variant__";
 constexpr char metaObjectProperty[] = "__qtscript_metaobject__";
 constexpr char staticScopeProperty[] = "__qtscript_static_scope__";
 
@@ -532,10 +531,9 @@ static QVariant variantFromObjectImpl(const QScriptValue &value,
     if (identity)
         visited->insert(identity);
 
-    if (!qScriptQuickJSScriptClass(value)
-        && state->variantClassId && JS_GetClassID(object) == state->variantClassId) {
-        if (void *opaque = JS_GetOpaque(object, state->variantClassId)) {
-            const QVariant result = *static_cast<const QVariant *>(opaque);
+    if (!qScriptQuickJSScriptClass(value)) {
+        if (const QScriptVariantPayload *payload = qscriptVariantPayload(state, object)) {
+            const QVariant result = payload->value;
             if (identity)
                 visited->remove(identity);
             return result;
@@ -548,20 +546,6 @@ static QVariant variantFromObjectImpl(const QScriptValue &value,
         return QVariant();
     }
 
-    JSValue stored = JS_GetPropertyStr(context, object, variantProperty);
-    if (!JS_IsException(stored) && !JS_IsUndefined(stored)) {
-        QScriptValue storedValue = engine->fromOwned(stored);
-        if (storedValue.isValid()) {
-            const QVariant result = variantFromObjectImpl(storedValue, visited);
-            if (identity)
-                visited->remove(identity);
-            return result;
-        }
-    } else {
-        JS_FreeValue(context, stored);
-        discardException(context);
-    }
-
     if (JS_IsArray(object)) {
         int64_t length = 0;
         if (JS_GetLength(context, object, &length) < 0) {
@@ -831,6 +815,50 @@ static bool detachedEquals(const QScriptValuePrivate *left,
 
 } // unnamed namespace
 
+QScriptVariantPayload *qscriptVariantPayload(QScriptEngineState *state,
+                                              JSValueConst value)
+{
+    if (!state || !state->context || !state->variantClassId || !JS_IsObject(value))
+        return nullptr;
+
+    if (JS_GetClassID(value) == state->variantClassId)
+        return static_cast<QScriptVariantPayload *>(
+            JS_GetOpaque(value, state->variantClassId));
+
+    // QScriptEngine::newVariant(object, value) stores the native wrapper in
+    // an own, non-enumerable marker.  Reading the descriptor is deliberately
+    // different from JS_GetPropertyStr: it cannot invoke a user getter or
+    // traverse the generated QObject/QScriptClass prototype bridge while a
+    // native overload is already converting an argument.
+    JSAtom marker = JS_NewAtom(state->context, "__qtscript_variant__");
+    if (marker == JS_ATOM_NULL)
+        return nullptr;
+    JSPropertyDescriptor descriptor{};
+    const int result = JS_GetOwnProperty(state->context, &descriptor, value, marker);
+    JS_FreeAtom(state->context, marker);
+    if (result < 0) {
+        JS_FreeValue(state->context, descriptor.value);
+        JS_FreeValue(state->context, descriptor.getter);
+        JS_FreeValue(state->context, descriptor.setter);
+        discardException(state->context);
+        return nullptr;
+    }
+    if (result == 0)
+        return nullptr;
+
+    QScriptVariantPayload *payload = nullptr;
+    if (!(descriptor.flags & JS_PROP_GETSET)
+        && JS_IsObject(descriptor.value)
+        && JS_GetClassID(descriptor.value) == state->variantClassId) {
+        payload = static_cast<QScriptVariantPayload *>(
+            JS_GetOpaque(descriptor.value, state->variantClassId));
+    }
+    JS_FreeValue(state->context, descriptor.value);
+    JS_FreeValue(state->context, descriptor.getter);
+    JS_FreeValue(state->context, descriptor.setter);
+    return payload;
+}
+
 QScriptValuePrivate::QScriptValuePrivate()
     : kind(Invalid)
 {
@@ -1128,12 +1153,7 @@ bool QScriptValue::isVariant() const
     // because the binding is represented by a prototype bridge.
     if (qScriptQuickJSScriptClass(*this))
         return false;
-    if (value->state->variantClassId && JS_GetClassID(value->value) == value->state->variantClassId)
-        return true;
-    JSValue marker = JS_GetPropertyStr(value->state->context, value->value, variantProperty);
-    const bool result = !JS_IsException(marker) && !JS_IsUndefined(marker);
-    JS_FreeValue(value->state->context, marker);
-    return result;
+    return qscriptVariantPayload(value->state.data(), value->value) != nullptr;
 }
 
 bool QScriptValue::isQObject() const
@@ -1350,31 +1370,11 @@ QVariant QScriptValue::toVariant() const
     // re-enter toVariant(), which is both unnecessary and can deadlock while
     // a generated overload is checking the value's QMetaType (QSqlDatabase
     // and QSqlQuery are prominent examples).
-    if (JS_IsObject(value->value) && value->state->variantClassId) {
-        // Most values use the variant class directly.  Generated QtScript
-        // constructors may instead attach that variant as the private marker
-        // on the JavaScript `this` object; recognize both forms without
-        // asking the QObject/script-class machinery to inspect the prototype.
-        JSValue variantObject = JS_UNDEFINED;
-        if (JS_GetClassID(value->value) == value->state->variantClassId) {
-            variantObject = JS_DupValue(value->state->context, value->value);
-        } else {
-            variantObject = JS_GetPropertyStr(value->state->context, value->value,
-                                              variantProperty);
+    if (JS_IsObject(value->value)) {
+        if (const QScriptVariantPayload *payload =
+                qscriptVariantPayload(value->state.data(), value->value)) {
+            return payload->value;
         }
-        if (!JS_IsException(variantObject)
-            && JS_GetClassID(variantObject) == value->state->variantClassId) {
-            if (const auto *payload = static_cast<const QScriptVariantPayload *>(
-                    JS_GetOpaque(variantObject, value->state->variantClassId))) {
-                const QVariant result = payload->value;
-                JS_FreeValue(value->state->context, variantObject);
-                return result;
-            }
-        }
-        if (!JS_IsException(variantObject))
-            JS_FreeValue(value->state->context, variantObject);
-        else
-            discardException(value->state->context);
     }
 
     if (isBool())
