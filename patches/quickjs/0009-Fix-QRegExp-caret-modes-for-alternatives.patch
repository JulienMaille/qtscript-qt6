From 5fbf0b6d7ef5d24b8eb7c3d07bb034e0e87a3bf7 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Tue, 11 Aug 2026 15:35:00 +0200
Subject: [PATCH 9/9] Fix QRegExp caret modes for alternatives

CaretWontMatch must disable only the anchored alternatives.  Replacing each
caret anchor with an always-failing assertion preserves unanchored
alternatives such as `^foo|bar`.

---
 src/script/api/qregexp.cpp | 39 ++++++++++++++++++++++++++++++--------------
 1 file changed, 28 insertions(+), 11 deletions(-)

diff --git a/src/script/api/qregexp.cpp b/src/script/api/qregexp.cpp
index f65b0ad..821830c 100644
--- a/src/script/api/qregexp.cpp
+++ b/src/script/api/qregexp.cpp
@@ -102,9 +102,10 @@ QString qt_regexp_toCanonical(const QString &pattern, QRegExp::PatternSyntax syn
 
 static QRegularExpression qregexpExpression(const QRegExpPrivate *d,
                                              bool anchored = false,
-                                             bool anchorAtStart = false)
+                                             bool anchorAtStart = false,
+                                             const QString &patternOverride = QString())
 {
-    QString pattern = qregexpPattern(d);
+    QString pattern = patternOverride.isNull() ? qregexpPattern(d) : patternOverride;
     if (anchored)
         pattern = QRegularExpression::anchoredPattern(pattern);
     else if (anchorAtStart)
@@ -148,6 +149,36 @@ static bool qregexpHasCaretAnchor(const QString &pattern)
     return false;
 }
 
+static QString qregexpDisableCaretAnchors(const QString &pattern)
+{
+    QString result;
+    result.reserve(pattern.size());
+    bool inClass = false;
+    bool escaped = false;
+    for (const QChar c : pattern) {
+        if (escaped) {
+            result += c;
+            escaped = false;
+        } else if (c == QLatin1Char('\\')) {
+            result += c;
+            escaped = true;
+        } else if (c == QLatin1Char('[')) {
+            result += c;
+            inClass = true;
+        } else if (c == QLatin1Char(']')) {
+            result += c;
+            inClass = false;
+        } else if (c == QLatin1Char('^') && !inClass) {
+            // An always-failing assertion removes only this alternative;
+            // unanchored alternatives such as ^foo|bar still participate.
+            result += QLatin1String("(?!)");
+        } else {
+            result += c;
+        }
+    }
+    return result;
+}
+
 QRegExp::QRegExp()
     : priv(new QRegExpPrivate)
 {
@@ -282,12 +313,12 @@ int QRegExp::indexIn(const QString &text, int offset, CaretMode caretMode) const
         return -1;
     }
     const QString pattern = qregexpPattern(priv);
-    const QRegularExpression expression = qregexpExpression(priv);
+    const bool hasCaret = qregexpHasCaretAnchor(pattern);
+    const QString patternOverride = caretMode == CaretWontMatch && hasCaret
+        ? qregexpDisableCaretAnchors(pattern) : QString();
+    const QRegularExpression expression = qregexpExpression(priv, false, false,
+                                                              patternOverride);
     priv->error = expression.errorString();
-    if (caretMode == CaretWontMatch && qregexpHasCaretAnchor(pattern)) {
-        qregexpClearMatch(priv);
-        return -1;
-    }
     QRegularExpression::MatchOptions options;
     // AnchorAtOffsetMatchOption anchors ^ at the offset, which is what
     // CaretAtOffset wants. Qt 5 also anchored a trailing $ there, which
@@ -309,12 +340,12 @@ int QRegExp::lastIndexIn(const QString &text, int offset, CaretMode caretMode) const
         return -1;
     }
     const QString pattern = qregexpPattern(priv);
-    const QRegularExpression expression = qregexpExpression(priv);
+    const bool hasCaret = qregexpHasCaretAnchor(pattern);
+    const QString patternOverride = caretMode == CaretWontMatch && hasCaret
+        ? qregexpDisableCaretAnchors(pattern) : QString();
+    const QRegularExpression expression = qregexpExpression(priv, false, false,
+                                                              patternOverride);
     priv->error = expression.errorString();
-    if (caretMode == CaretWontMatch && qregexpHasCaretAnchor(pattern)) {
-        qregexpClearMatch(priv);
-        return -1;
-    }
     // Qt 5 tried each position and returned the highest one whose match
     // starts there; a plain globalMatch scan would miss overlapping matches
     // (e.g. "a+" in "aaa").
 
