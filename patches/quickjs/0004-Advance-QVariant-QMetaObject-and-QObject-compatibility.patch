+    if (value.metaType().id() == qMetaTypeId<QScriptValue>())
+        return *static_cast<const QScriptValue *>(value.constData());
     const QMetaType type = value.metaType();
     if (type.flags().testFlag(QMetaType::IsEnumeration))
         return QScriptValue(q_func(), value.toInt());
@@ -404,6 +480,10 @@ bool QScriptEnginePrivate::toVariantType(const QScriptValue &value, QMetaType ty
 
     if (type.flags().testFlag(QMetaType::IsPointer)) {
         if (type.flags().testFlag(QMetaType::PointerToQObject)) {
+            if (value.isNull() || value.isUndefined()) {
+                *static_cast<QObject **>(destination) = nullptr;
+                return true;
+            }
             if (QObject *object = value.toQObject()) {
                 const QMetaObject *targetMetaObject = type.metaObject();
                 QObject *convertedObject = targetMetaObject
@@ -506,6 +586,7 @@ bool QScriptEnginePrivate::toVariantType(const QScriptValue &value, QMetaType ty
                 *static_cast<void **>(destination) = pointer;
                 return true;
             }
+            return false;
         }
     }
 
@@ -539,6 +620,11 @@ bool QScriptEnginePrivate::toVariantType(const QScriptValue &value, QMetaType ty
         return true;
     case QMetaType::QVariant: *static_cast<QVariant *>(destination) = value.toVariant(); return true;
     case QMetaType::QObjectStar: *static_cast<QObject **>(destination) = value.toQObject(); return true;
+    case QMetaType::VoidStar:
+        if (!value.isNull())
+            return false;
+        *static_cast<void **>(destination) = nullptr;
+        return true;
     default: break;
     }
 
@@ -976,11 +1062,29 @@ QScriptValue QScriptEngine::newQObject(const QScriptValue &scriptObject, QObject
     return d->wrapQObject(scriptObject, object, ownership, options);
 }
 
+static QScriptValue qScriptMetaObjectConstructor(QScriptContext *context,
+                                                 QScriptEngine *engine, void *)
+{
+    QObject *parent = context->argumentCount() > 0
+        ? context->argument(0).toQObject() : nullptr;
+    QObject *object = new QObject(parent);
+    if (context->isCalledAsConstructor())
+        return engine->newQObject(context->thisObject(), object,
+                                  QScriptEngine::AutoOwnership);
+    return engine->newQObject(object, QScriptEngine::AutoOwnership);
+}
+
 QScriptValue QScriptEngine::newQMetaObject(const QMetaObject *metaObject, const QScriptValue &ctor)
 {
-    QScriptValue result = ctor.isFunction() ? ctor : newObject();
+    QScriptValue result = ctor.isFunction()
+        ? ctor
+        : newFunction(reinterpret_cast<FunctionWithArgSignature>(
+                          qScriptMetaObjectConstructor), const_cast<QMetaObject *>(metaObject));
     if (!metaObject)
         return result;
+    result.setProperty(QString::fromLatin1(metaObjectProperty),
+                       newVariant(QVariant::fromValue(metaObject)),
+                       QScriptValue::Undeletable | QScriptValue::SkipInEnumeration);
     for (int index = 0; index < metaObject->enumeratorCount(); ++index) {
         const QMetaEnum enumerator = metaObject->enumerator(index);
         for (int key = 0; key < enumerator.keyCount(); ++key)
@@ -1122,6 +1226,37 @@ QStringList QScriptEngine::importedExtensions() const
 void QScriptEngine::collectGarbage()
 {
     Q_D(QScriptEngine);
+    // The QObject wrapper cache owns one reference per wrapper so that
+    // PreferExistingWrapperObject remains stable.  Release script-owned
+    // references at an explicit GC boundary; otherwise the cache would keep
+    // AutoOwnership and ScriptOwnership objects alive indefinitely.  Mark
+    // entries before freeing because a QObject finalizer can synchronously
+    // remove its cache entry through the destroyed signal.
+    QVector<JSValue> release;
+    for (auto it = d->state->qobjectWrappers.begin();
+         it != d->state->qobjectWrappers.end(); ++it) {
+        for (QScriptQObjectWrapper &wrapper : it.value()) {
+            if (wrapper.ownership == QScriptEngine::QtOwnership
+                || JS_IsUndefined(wrapper.value))
+                continue;
+            release.append(wrapper.value);
+            wrapper.value = JS_UNDEFINED;
+        }
+    }
+    for (JSValue value : std::as_const(release))
+        JS_FreeValue(d->state->context, value);
+    for (auto it = d->state->qobjectWrappers.begin();
+         it != d->state->qobjectWrappers.end();) {
+        it.value().erase(std::remove_if(it.value().begin(), it.value().end(),
+                                        [](const QScriptQObjectWrapper &wrapper) {
+                                            return JS_IsUndefined(wrapper.value);
+                                        }),
+                                        it.value().end());
+        if (it.value().isEmpty())
+            it = d->state->qobjectWrappers.erase(it);
+        else
+            ++it;
+    }
     JS_RunGC(d->state->runtime);
 }
 
