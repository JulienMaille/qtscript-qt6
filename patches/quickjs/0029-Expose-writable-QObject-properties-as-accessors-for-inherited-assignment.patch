From 79a01a1937e98875ae419c539b9bd2c637500ee8 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript@example.com>
Date: Mon, 31 Aug 2026 23:38:27 +0200
Subject: [PATCH 2/7] Expose writable QObject properties as accessors for
 inherited assignment

QObject Q_PROPERTYs were only reachable through the wrapper's exotic
define-own-property hook, which fires only for direct assignment on the
wrapper object itself. When a plain object inherited from the wrapper
(e.g. `o.__proto__ = scriptable`) and a writable property was assigned
(`o.oof = x`), QuickJS found no accessor in the prototype chain and silently
created a shadowing own data property instead of invoking the setter.

Report scriptable Q_PROPERTYs from get_own_property as accessor
properties: writable ones get a real property setter so inherited
assignment (and direct assignment) lands on the QObject property with the
correct receiver as thisObject; read-only ones get a getter-only accessor
so inherited writes are rejected instead of shadowed. The descriptor for a
meta-property carries JS_PROP_ENUMERABLE to match the enumerable getset
entry populateQObject installs in the wrapper shape (dynamic properties
already matched; named child objects have no shape entry and stay
non-enumerable).
---
 src/script/quickjs/qscriptqobjectquickjs.cpp | 47 +++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 39 insertions(+), 8 deletions(-)

diff --git a/src/script/quickjs/qscriptqobjectquickjs.cpp b/src/script/quickjs/qscriptqobjectquickjs.cpp
index dcfb72e..2d26295 100644
--- a/src/script/quickjs/qscriptqobjectquickjs.cpp
+++ b/src/script/quickjs/qscriptqobjectquickjs.cpp
@@ -476,22 +476,47 @@ static int qobjectGetOwnProperty(JSContext *context, JSPropertyDescriptor *descr
         return 1;
     }
     PropertyClosure::Kind kind;
-    if (dynamicPropertyExists(payload->object, propertyName))
+    int metaPropertyIndex = -1;
+    bool metaWritable = false;
+    if (dynamicPropertyExists(payload->object, propertyName)) {
         kind = PropertyClosure::DynamicProperty;
-    else if (!payload->options.testFlag(QScriptEngine::ExcludeChildObjects)
-             && namedChild(payload->object, propertyName))
+    } else if (!payload->options.testFlag(QScriptEngine::ExcludeChildObjects)
+               && namedChild(payload->object, propertyName)) {
         kind = PropertyClosure::ChildObject;
-    else
-        return 0;
+    } else {
+        const QMetaObject *metaObject = payload->object->metaObject();
+        const int propertyIndex = metaObject->indexOfProperty(propertyName.constData());
+        if (propertyIndex < 0)
+            return 0;
+        const QMetaProperty property = metaObject->property(propertyIndex);
+        const bool excludeSuper =
+            payload->options.testFlag(QScriptEngine::ExcludeSuperClassProperties)
+            || payload->options.testFlag(QScriptEngine::ExcludeSuperClassContents);
+        if (!property.isScriptable()
+            || (excludeSuper && propertyIndex < metaObject->propertyOffset()))
+            return 0;
+        kind = PropertyClosure::MetaProperty;
+        metaPropertyIndex = propertyIndex;
+        metaWritable = property.isWritable();
+    }
     if (!descriptor)
         return 1;
 
-    auto *getterClosure = new PropertyClosure{payload->object, -1, state, kind, propertyName};
+    auto *getterClosure = new PropertyClosure{payload->object, metaPropertyIndex, state,
+                                              kind, propertyName};
     JSValue getter = makeClosure(context, propertyGetter, propertyName.constData(),
                                  deletePropertyClosure, getterClosure);
     JSValue setter = JS_UNDEFINED;
-    if (kind == PropertyClosure::DynamicProperty) {
-        auto *setterClosure = new PropertyClosure{payload->object, -1, state, kind, propertyName};
+    // Dynamic properties and writable meta-properties expose a real setter so
+    // that assignments made through a prototype-inheriting receiver (e.g.
+    // `o.oof = x` with `o.__proto__ = scriptable`) land on the QObject
+    // property instead of silently creating an own shadowing property.  A
+    // read-only meta-property is exposed as a getter-only accessor so writes
+    // through inheritance are rejected rather than shadowed.
+    if (kind == PropertyClosure::DynamicProperty
+        || (kind == PropertyClosure::MetaProperty && metaWritable)) {
+        auto *setterClosure = new PropertyClosure{payload->object, metaPropertyIndex, state,
+                                                  kind, propertyName};
         setter = makeClosure(context, propertySetter, propertyName.constData(),
                              deletePropertyClosure, setterClosure);
     }

diff --git a/src/script/quickjs/qscriptqobjectquickjs.cpp b/src/script/quickjs/qscriptqobjectquickjs.cpp
index 2d26295..aad6517 100644
--- a/src/script/quickjs/qscriptqobjectquickjs.cpp
+++ b/src/script/quickjs/qscriptqobjectquickjs.cpp
@@ -527,6 +527,12 @@ static int qobjectGetOwnProperty(JSContext *context, JSPropertyDescriptor *descr
         | JS_PROP_HAS_ENUMERABLE | JS_PROP_HAS_CONFIGURABLE;
     if (kind == PropertyClosure::DynamicProperty)
         descriptor->flags |= JS_PROP_ENUMERABLE | JS_PROP_CONFIGURABLE;
+    else if (kind == PropertyClosure::MetaProperty)
+        // populateQObject installs meta-properties as enumerable getset
+        // shape entries (JS_PROP_ENUMERABLE); mirror that flag so the exotic
+        // hook never disagrees with the shape when it fires for a property
+        // the shape also carries.
+        descriptor->flags |= JS_PROP_ENUMERABLE;
     return 1;
 }
 
