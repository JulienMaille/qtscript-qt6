From 09fcc4a7855b68a07c4ead0512e1a19b3e6c9f4b Mon Sep 17 00:00:00 2001
From: Julien Maille <julien.maille@gmail.com>
Date: Mon, 10 Aug 2026 02:06:36 +0200
Subject: [PATCH] Add bounded QuickJS execution and context frames

---
 .../quickjs/qscriptcontextinfoquickjs.cpp     |  9 +-
 src/script/quickjs/qscriptenginequickjs.cpp   | 96 ++++++++++++++++---
 src/script/quickjs/qscriptquickjs_p.h         |  7 ++
 src/script/quickjs/qscriptvaluequickjs.cpp    | 38 +++++++-
 4 files changed, 132 insertions(+), 18 deletions(-)

diff --git a/src/script/quickjs/qscriptcontextinfoquickjs.cpp b/src/script/quickjs/qscriptcontextinfoquickjs.cpp
index 426506a..68ca8ed 100644
--- a/src/script/quickjs/qscriptcontextinfoquickjs.cpp
+++ b/src/script/quickjs/qscriptcontextinfoquickjs.cpp
@@ -49,10 +49,11 @@ QScriptContextInfoPrivate::QScriptContextInfoPrivate(const QScriptContext *conte
     if (!contextPrivate)
         return;
 
-    // QScriptContextPrivate deliberately carries only the portable call data.
-    // QuickJS does not expose source locations or a public bytecode-function
-    // discriminator here, so leave those fields at their documented neutral
-    // values instead of guessing from engine-internal implementation details.
+    scriptId = contextPrivate->scriptId;
+    lineNumber = contextPrivate->lineNumber;
+    columnNumber = contextPrivate->columnNumber;
+    fileName = contextPrivate->fileName;
+
     const QScriptValue callee = contextPrivate->callee;
     if (!callee.isValid() || !callee.isFunction())
         return;
diff --git a/src/script/quickjs/qscriptenginequickjs.cpp b/src/script/quickjs/qscriptenginequickjs.cpp
index 7e91268..9001847 100644
--- a/src/script/quickjs/qscriptenginequickjs.cpp
+++ b/src/script/quickjs/qscriptenginequickjs.cpp
@@ -525,7 +525,25 @@ void variantFinalizer(JSRuntime *, JSValueConst value)
 int interruptHandler(JSRuntime *, void *opaque)
 {
     auto *state = static_cast<QScriptEngineState *>(opaque);
-    return state && state->abortRequested;
+    if (!state)
+        return 0;
+    if (state->abortRequested)
+        return 1;
+    return state->evaluationDeadline > 0
+        && QDateTime::currentMSecsSinceEpoch() >= state->evaluationDeadline;
+}
+
+static void setEvaluationFrameMetadata(QScriptContextPrivate *contextPrivate,
+                                       qint64 scriptId, const QString &fileName,
+                                       int lineNumber)
+{
+    if (!contextPrivate)
+        return;
+    contextPrivate->scriptId = scriptId;
+    contextPrivate->fileName = fileName;
+    contextPrivate->lineNumber = lineNumber;
+    contextPrivate->columnNumber = 1;
+    contextPrivate->backtraceName = QStringLiteral("<global>");
 }
 
 JSValue nativeFunctionThunk(JSContext *context, JSValueConst, int argc,
@@ -541,20 +559,11 @@ JSValue nativeFunctionThunk(JSContext *context, JSValueConst, int argc,
 
     QScriptEngine *engine = state->engine;
     QScriptEnginePrivate *enginePrivate = QScriptEnginePrivate::get(engine);
-    QScriptContext *javaScriptContext = nullptr;
     QScriptContext *parentContext = state->currentContext;
-    if (state->evaluating) {
-        // QuickJS does not expose its JavaScript call frames through the public API.
-        // Keep a stable compatibility frame so parentContext() remains safe for
-        // native callbacks invoked by JavaScript. Its global activation accurately
-        // represents the minimum context information available from QuickJS.
-        javaScriptContext = createEngineContext(engine, parentContext,
-                                                engine->globalObject(), false);
-        parentContext = javaScriptContext;
-    }
     QScriptContext *scriptContext = createEngineContext(engine, parentContext,
                                                         engine->globalObject(), true);
     QScriptContextPrivate *contextPrivate = QScriptContextPrivate::get(scriptContext);
+    contextPrivate->backtraceName = QStringLiteral("<native>");
     contextPrivate->calledAsConstructor = argc > 1 && JS_ToBool(context, argv[1]);
     if (argc > 0)
         contextPrivate->callee = enginePrivate->fromBorrowed(argv[0]);
@@ -584,7 +593,6 @@ JSValue nativeFunctionThunk(JSContext *context, JSValueConst, int argc,
         state->agent->contextPop();
     state->currentContext = previousContext;
     delete scriptContext;
-    delete javaScriptContext;
 
     bool conversionOk = false;
     JSValue quickResult = enginePrivate->toQuickJS(threw ? thrownValue : result, &conversionOk);
@@ -676,6 +684,12 @@ QScriptEngineState::QScriptEngineState()
     runtime = JS_NewRuntime();
     if (!runtime)
         return;
+    // Keep QuickJS stack exhaustion inside the VM.  The default one-megabyte
+    // limit is close enough to the Windows thread guard page that a deeply
+    // recursive script can terminate the host process before QuickJS throws.
+    // This is a backend safety limit, not a replacement for QtScript's
+    // abortEvaluation() API.
+    JS_SetMaxStackSize(runtime, 256 * 1024);
     context = JS_NewContext(runtime);
     if (!context) {
         JS_FreeRuntime(runtime);
@@ -1380,11 +1394,53 @@ QScriptValue QScriptEngine::evaluate(const QString &program, const QString &file
     state->clearException();
     state->abortRequested = false;
     d->syncGlobalObjectToRuntime();
+    JS_UpdateStackTop(state->runtime);
     state->evaluating = true;
+    const qint64 previousDeadline = state->evaluationDeadline;
+    bool timeoutOk = false;
+    const qint64 timeoutMs = qEnvironmentVariableIntValue("QTSCRIPT_EVAL_TIMEOUT_MS",
+                                                          &timeoutOk);
+    if (timeoutOk && timeoutMs > 0)
+        state->evaluationDeadline = QDateTime::currentMSecsSinceEpoch() + timeoutMs;
+    else
+        state->evaluationDeadline = 0;
     const qint64 scriptId = state->nextScriptId++;
     if (state->agent)
         state->agent->scriptLoad(scriptId, program, fileName, lineNumber);
 
+    QScriptContext *previousContext = state->currentContext;
+    QScriptContext *evaluationContext = createEngineContext(this, previousContext,
+                                                             globalObject(), false);
+    QScriptContextPrivate *evaluationPrivate = QScriptContextPrivate::get(evaluationContext);
+    setEvaluationFrameMetadata(evaluationPrivate, scriptId, fileName, lineNumber);
+    state->currentContext = evaluationContext;
+
+    // A nested evaluation from a native callback still observes that
+    // callback's arguments object in QtScript.  QuickJS evaluates this API as
+    // global code, so install a temporary global binding and restore the
+    // original descriptor immediately after the evaluation.
+    JSAtom argumentsAtom = JS_NewAtom(state->context, "arguments");
+    JSPropertyDescriptor previousArguments{};
+    const int previousArgumentsResult = JS_GetOwnProperty(state->context,
+                                                          &previousArguments,
+                                                          state->runtimeGlobal,
+                                                          argumentsAtom);
+    if (previousArgumentsResult < 0)
+        discardQuickJSException(state->context);
+    const bool hasPreviousArguments = previousArgumentsResult > 0;
+    bool hasTemporaryArguments = false;
+    QScriptContextPrivate *previousPrivate = QScriptContextPrivate::get(previousContext);
+    if (previousPrivate && previousPrivate->callee.isValid()) {
+        bool argumentsOk = false;
+        JSValue nestedArguments = d->toQuickJS(previousContext->argumentsObject(),
+                                               &argumentsOk);
+        if (argumentsOk) {
+            JS_DefinePropertyValue(state->context, state->runtimeGlobal, argumentsAtom,
+                                   nestedArguments, JS_PROP_C_W_E);
+            hasTemporaryArguments = true;
+        }
+    }
+
     const QByteArray source = program.toUtf8();
     const QByteArray name = fileName.isEmpty() ? QByteArrayLiteral("<eval>") : fileName.toUtf8();
     JSEvalOptions options{};
@@ -1393,7 +1449,23 @@ QScriptValue QScriptEngine::evaluate(const QString &program, const QString &file
     options.filename = name.constData();
     options.line_num = lineNumber;
     JSValue value = JS_Eval2(state->context, source.constData(), size_t(source.size()), &options);
+    if (hasTemporaryArguments)
+        JS_DeleteProperty(state->context, state->runtimeGlobal, argumentsAtom, 0);
+    if (hasPreviousArguments) {
+        defineGlobalDescriptor(state->context, state->runtimeGlobal, argumentsAtom,
+                               &previousArguments);
+        previousArguments.value = JS_UNDEFINED;
+        previousArguments.getter = JS_UNDEFINED;
+        previousArguments.setter = JS_UNDEFINED;
+    } else {
+        JS_DeleteProperty(state->context, state->runtimeGlobal, argumentsAtom, 0);
+    }
+    freeQuickJSDescriptor(state->context, &previousArguments);
+    JS_FreeAtom(state->context, argumentsAtom);
+    state->currentContext = previousContext;
+    delete evaluationContext;
     state->evaluating = false;
+    state->evaluationDeadline = previousDeadline;
     d->syncRuntimeGlobalObject();
 
     QScriptValue result;
diff --git a/src/script/quickjs/qscriptquickjs_p.h b/src/script/quickjs/qscriptquickjs_p.h
index 7b41a55..15b5dbe 100644
--- a/src/script/quickjs/qscriptquickjs_p.h
+++ b/src/script/quickjs/qscriptquickjs_p.h
@@ -95,6 +95,7 @@ public:
 
     bool evaluating = false;
     bool abortRequested = false;
+    qint64 evaluationDeadline = 0;
     bool hasException = false;
     int exceptionLine = -1;
     QStringList exceptionBacktrace;
@@ -190,8 +191,14 @@ public:
     QScriptValue returnValue;
     QScriptValue thrownValue;
     QScriptValueList arguments;
+    QScriptValue argumentsObjectCache;
     QScriptValueList scopes;
     bool calledAsConstructor = false;
+    qint64 scriptId = -1;
+    int lineNumber = -1;
+    int columnNumber = -1;
+    QString fileName;
+    QString backtraceName;
 };
 
 class QScriptEnginePrivate : public QObjectPrivate
diff --git a/src/script/quickjs/qscriptvaluequickjs.cpp b/src/script/quickjs/qscriptvaluequickjs.cpp
index 7fbf82a..f95b0ca 100644
--- a/src/script/quickjs/qscriptvaluequickjs.cpp
+++ b/src/script/quickjs/qscriptvaluequickjs.cpp
@@ -605,6 +605,24 @@ static QScriptValue callWithArguments(QScriptValuePrivate *privateValue,
         return invalidValue();
     }
 
+    QScriptContext *callContext = QScriptContextPrivate::create();
+    QScriptContextPrivate *callContextPrivate = QScriptContextPrivate::get(callContext);
+    callContextPrivate->engine = state->engine;
+    callContextPrivate->parent = state->currentContext;
+    callContextPrivate->callee = publicFunction;
+    callContextPrivate->thisObject = thisObject.isValid() ? thisObject : state->engine->globalObject();
+    callContextPrivate->activationObject = state->engine->newObject();
+    callContextPrivate->scopes.append(callContextPrivate->activationObject);
+    callContextPrivate->scopes.append(state->engine->globalObject());
+    callContextPrivate->calledAsConstructor = construct;
+    for (const JSValue &argument : arguments)
+        callContextPrivate->arguments.append(engine->fromBorrowed(argument));
+
+    QScriptContext *previousContext = state->currentContext;
+    state->currentContext = callContext;
+    if (state->agent)
+        state->agent->contextPush();
+
     JSValue result = JS_UNDEFINED;
     if (construct) {
         result = JS_CallConstructor(context, function, arguments.size(), arguments.data());
@@ -613,6 +631,10 @@ static QScriptValue callWithArguments(QScriptValuePrivate *privateValue,
         bool receiverOwned = false;
         if (thisObject.isValid()) {
             if (!materialize(thisObject, engine, &receiver)) {
+                if (state->agent)
+                    state->agent->contextPop();
+                state->currentContext = previousContext;
+                delete callContext;
                 JS_FreeValue(context, function);
                 return invalidValue();
             }
@@ -622,6 +644,10 @@ static QScriptValue callWithArguments(QScriptValuePrivate *privateValue,
         if (receiverOwned)
             JS_FreeValue(context, receiver);
     }
+    if (state->agent)
+        state->agent->contextPop();
+    state->currentContext = previousContext;
+    delete callContext;
     JS_FreeValue(context, function);
 
     if (JS_IsException(result))
@@ -2100,6 +2126,8 @@ QScriptValue QScriptContext::argumentsObject() const
     QScriptEnginePrivate *engine = QScriptEnginePrivate::get(d_ptr->engine);
     if (!engine)
         return invalidValue();
+    if (d_ptr->argumentsObjectCache.isValid())
+        return d_ptr->argumentsObjectCache;
     QScriptValue result = d_ptr->engine->newObject();
     result.setProperty(QStringLiteral("length"), QScriptValue(d_ptr->engine,
                                                                int(d_ptr->arguments.size())),
@@ -2109,6 +2137,7 @@ QScriptValue QScriptContext::argumentsObject() const
                            QScriptValue::SkipInEnumeration);
     for (int index = 0; index < d_ptr->arguments.size(); ++index)
         result.setProperty(uint(index), d_ptr->arguments.at(index));
+    d_ptr->argumentsObjectCache = result;
     return result;
 }
 
@@ -2273,7 +2302,8 @@ QString QScriptContext::toString() const
 {
     if (!d_ptr)
         return QString();
-    QString result = contextFunctionName(d_ptr);
+    QString result = d_ptr->backtraceName.isEmpty() ? contextFunctionName(d_ptr)
+                                                    : d_ptr->backtraceName;
     result += QLatin1Char('(');
     for (int index = 0; index < d_ptr->arguments.size(); ++index) {
         if (index)
@@ -2285,7 +2315,11 @@ QString QScriptContext::toString() const
         if (argumentValue.isString())
             result += QLatin1Char('\'');
     }
-    result += QStringLiteral(") at : -1");
+    result += QStringLiteral(") at ");
+    if (!d_ptr->fileName.isEmpty())
+        result += d_ptr->fileName + QLatin1Char(':') + QString::number(d_ptr->lineNumber);
+    else
+        result += QString::number(d_ptr->lineNumber);
     return result;
 }
 
