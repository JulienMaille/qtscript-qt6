+static JSFunctionBytecode *js_get_function_bytecode(JSValueConst func)
+{
+    if (JS_VALUE_GET_TAG(func) != JS_TAG_OBJECT)
+        return NULL;
+    JSObject *p = JS_VALUE_GET_OBJ(func);
+    if (!js_class_has_bytecode(p->class_id))
+        return NULL;
+    return p->u.func.function_bytecode;
+}
+
+JSValue JS_GetStackFrameFunction(JSContext *ctx, int n_stack_levels)
+{
+    if (!ctx || n_stack_levels < 0)
+        return JS_UNDEFINED;
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && n_stack_levels-- > 0)
+        sf = sf->prev_frame;
+    return sf ? JS_DupValue(ctx, sf->cur_func) : JS_UNDEFINED;
+}
+
+int JS_GetStackFrameLocation(JSContext *ctx, int n_stack_levels,
+                             int *line_num, int *col_num)
+{
+    if (line_num)
+        *line_num = -1;
+    if (col_num)
+        *col_num = -1;
+    if (!ctx || n_stack_levels < 0)
+        return -1;
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && n_stack_levels-- > 0)
+        sf = sf->prev_frame;
+    if (!sf || !sf->cur_pc)
+        return -1;
+    JSFunctionBytecode *b = js_get_function_bytecode(sf->cur_func);
+    if (!b)
+        return -1;
+    int col = 1;
+    const uint32_t pc = (uint32_t)(sf->cur_pc - b->byte_code_buf);
+    const int line = find_line_num(ctx, b, pc, &col);
+    if (line_num)
+        *line_num = line;
+    if (col_num)
+        *col_num = col;
+    return 0;
+}
+
+int JS_GetFunctionInfo(JSContext *ctx, JSValueConst func,
+                       JSAtom *filename, int *line_num, int *col_num,
+                       int *end_line_num, int *arg_count)
+{
+    JSFunctionBytecode *b = js_get_function_bytecode(func);
+    if (!b)
+        return -1;
+    if (filename)
+        *filename = JS_DupAtom(ctx, b->filename);
+    if (line_num)
+        *line_num = b->line_num;
+    if (col_num)
+        *col_num = b->col_num;
+    if (arg_count)
+        *arg_count = b->arg_count;
+    if (end_line_num) {
+        int end = b->line_num;
+        for (int index = 0; index < b->source_len; ++index) {
+            if (b->source[index] == '\n')
+                ++end;
+        }
+        *end_line_num = end;
+    }
+    return 0;
+}
+
+JSAtom JS_GetFunctionParameterName(JSContext *ctx, JSValueConst func, int index)
+{
+    JSFunctionBytecode *b = js_get_function_bytecode(func);
+    if (!b || index < 0 || index >= b->arg_count)
+        return JS_ATOM_NULL;
+    return JS_DupAtom(ctx, b->vardefs[index].var_name);
+}
+
 JSAtom JS_GetModuleName(JSContext *ctx, JSModuleDef *m)
 {
     return JS_DupAtom(ctx, m->module_name);
