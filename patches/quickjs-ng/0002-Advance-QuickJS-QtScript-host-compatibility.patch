+JSValue JS_GetStackFrameThis(JSContext *ctx, int n_stack_levels)
+{
+    if (!ctx || n_stack_levels < 0)
+        return JS_UNDEFINED;
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && n_stack_levels-- > 0)
+        sf = sf->prev_frame;
+    return sf ? JS_DupValue(ctx, sf->this_val) : JS_UNDEFINED;
+}
+
+int JS_IsStackFrameConstructor(JSContext *ctx, int n_stack_levels)
+{
+    if (!ctx || n_stack_levels < 0)
+        return 0;
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && n_stack_levels-- > 0)
+        sf = sf->prev_frame;
+    return sf ? sf->is_constructor : 0;
+}
+
+int JS_GetStackFrameArgumentCount(JSContext *ctx, int n_stack_levels)
+{
+    if (!ctx || n_stack_levels < 0)
+        return 0;
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && n_stack_levels-- > 0)
+        sf = sf->prev_frame;
+    return sf ? sf->actual_arg_count : 0;
+}
+
+JSValue JS_GetStackFrameArgument(JSContext *ctx, int n_stack_levels, int index)
+{
+    if (!ctx || n_stack_levels < 0 || index < 0)
+        return JS_UNDEFINED;
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    while (sf && n_stack_levels-- > 0)
+        sf = sf->prev_frame;
+    if (!sf || !sf->arg_buf || index >= sf->actual_arg_count)
+        return JS_UNDEFINED;
+    return JS_DupValue(ctx, sf->arg_buf[index]);
+}
+
