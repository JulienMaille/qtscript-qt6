Subject: [PATCH 5/7] Replace removed QBoolBlocker helper

---
 src/script/api/qscriptengine.cpp    | 3 ++-
 src/script/bridge/qscriptobject.cpp | 5 +++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/script/api/qscriptengine.cpp b/src/script/api/qscriptengine.cpp
index 2a2f002..46a02e6 100644
--- a/src/script/api/qscriptengine.cpp
+++ b/src/script/api/qscriptengine.cpp
@@ -56,6 +56,7 @@
 #include <QtCore/qstringlist.h>
 #include <QtCore/qshareddata.h>
 #include <QtCore/qmetaobject.h>
+#include <QtCore/qscopedvaluerollback.h>
 
 #include <math.h>
 #include <algorithm>
@@ -1374,7 +1375,7 @@ JSC::JSValue QScriptEnginePrivate::evaluateHelper(JSC::ExecState *exec, intptr_t
                                                   bool &compile)
 {
     Q_Q(QScriptEngine);
-    QBoolBlocker inEvalBlocker(inEval, true);
+    QScopedValueRollback<bool> inEvalBlocker(inEval, true);
     q->currentContext()->activationObject(); //force the creation of a context for native function;
 
     JSC::Debugger* debugger = originalGlobalObject()->debugger();
diff --git a/src/script/bridge/qscriptobject.cpp b/src/script/bridge/qscriptobject.cpp
index 58416b8..bfac035 100644
--- a/src/script/bridge/qscriptobject.cpp
+++ b/src/script/bridge/qscriptobject.cpp
@@ -39,7 +39,8 @@
 
 #include "config.h"
 #include "qscriptobject_p.h"
-#include "private/qobject_p.h"
+
+#include <QtCore/qscopedvaluerollback.h>
 
 namespace JSC
 {
@@ -128,7 +129,7 @@ void QScriptObject::markChildren(JSC::MarkStack& markStack)
         d = new Data();
     if (d->isMarking)
         return;
-    QBoolBlocker markBlocker(d->isMarking, true);
+    QScopedValueRollback<bool> markBlocker(d->isMarking, true);
     if (d && d->data)
         markStack.append(d->data);
     if (!d || !d->delegate) {
