+static JSValue scopeAccessorThunk(JSContext *context, JSValueConst,
+                                  int argc, JSValueConst *argv, int magic,
+                                  JSValueConst *data)
+{
+    if (JS_IsUndefined(data[0]))
+        return JS_UNDEFINED;
+    const int argumentCount = magic == 0 ? 0 : std::min(argc, 1);
+    return JS_Call(context, data[0], data[1], argumentCount, argv);
+}
+
+static JSValue boundScopeAccessor(JSContext *context, JSValueConst accessor,
+                                  JSValueConst scope, int magic)
+{
+    JSValue data[] = { accessor, scope };
+    return JS_NewCFunctionData(context, scopeAccessorThunk, magic == 0 ? 0 : 1,
+                               magic, 2, data);
+}
+
+static JSValue scopedFunctionThunk(JSContext *context, JSValueConst thisValue,
+                                   int argc, JSValueConst *argv, int,
+                                   JSValueConst *data)
+{
+    auto *state = static_cast<QScriptEngineState *>(JS_GetContextOpaque(context));
+    if (!state)
+        return JS_ThrowInternalError(context, "QScriptEngine has been destroyed");
+
+    struct TemporaryScopeBinding {
+        JSAtom atom = JS_ATOM_NULL;
+        JSPropertyDescriptor previous{};
+        bool hadPrevious = false;
+    };
+    QVector<TemporaryScopeBinding> bindings;
+    JSPropertyEnum *properties = nullptr;
+    uint32_t count = 0;
+    if (JS_GetOwnPropertyNames(context, &properties, &count, data[2],
+                               JS_GPN_STRING_MASK) < 0) {
+        discardQuickJSException(context);
+        return JS_ThrowInternalError(context, "Unable to materialize function scope");
+    }
+
+    for (uint32_t index = 0; index < count; ++index) {
+        const JSAtom atom = properties[index].atom;
+        JSPropertyDescriptor source{};
+        if (JS_GetOwnProperty(context, &source, data[1], atom) <= 0)
+            continue;
+        TemporaryScopeBinding binding;
+        binding.atom = JS_DupAtom(context, atom);
+        const int previousResult = JS_GetOwnProperty(
+            context, &binding.previous, state->runtimeGlobal, atom);
+        if (previousResult < 0) {
+            discardQuickJSException(context);
+            freeQuickJSDescriptor(context, &source);
+            JS_FreeAtom(context, binding.atom);
+            binding.atom = JS_ATOM_NULL;
+            continue;
+        }
+        binding.hadPrevious = previousResult > 0;
+        int flags = source.flags & JS_PROP_C_W_E;
+        flags |= JS_PROP_CONFIGURABLE | JS_PROP_HAS_CONFIGURABLE;
+        if (source.flags & JS_PROP_GETSET)
+            flags |= JS_PROP_HAS_GET | JS_PROP_HAS_SET;
+        else
+            flags |= JS_PROP_HAS_VALUE | JS_PROP_HAS_WRITABLE;
+        if (JS_DefineProperty(context, state->runtimeGlobal, atom,
+                              source.value, source.getter, source.setter, flags) < 0) {
+            discardQuickJSException(context);
+            JS_FreeValue(context, binding.previous.value);
+            JS_FreeValue(context, binding.previous.getter);
+            JS_FreeValue(context, binding.previous.setter);
+            JS_FreeAtom(context, binding.atom);
+            binding.atom = JS_ATOM_NULL;
+        } else {
+            bindings.append(binding);
+            if (!(source.flags & JS_PROP_CONFIGURABLE))
+                JS_SetQtScriptPropertyUndeletable(context, state->runtimeGlobal,
+                                                  atom, true);
+        }
+        freeQuickJSDescriptor(context, &source);
+    }
+    JS_FreePropertyEnum(context, properties, count);
+
+    JSValue result = JS_Call(context, data[0], thisValue, argc, argv);
+    JSValue callException = JS_UNDEFINED;
+    bool hasCallException = false;
+    if (JS_IsException(result) && JS_HasException(context)) {
+        callException = JS_GetException(context);
+        hasCallException = true;
+    }
+    for (auto it = bindings.crbegin(); it != bindings.crend(); ++it) {
+        JSPropertyDescriptor current{};
+        const int currentResult = JS_GetOwnProperty(context, &current,
+                                                     state->runtimeGlobal,
+                                                     it->atom);
+        if (currentResult > 0 && !(current.flags & JS_PROP_GETSET)) {
+            if (JS_SetProperty(context, data[1], it->atom,
+                               JS_DupValue(context, current.value)) < 0)
+                discardQuickJSException(context);
+        } else if (currentResult == 0) {
+            if (JS_DeleteProperty(context, data[1], it->atom, 0) < 0)
+                discardQuickJSException(context);
+        } else if (currentResult < 0) {
+            discardQuickJSException(context);
+        }
+        freeQuickJSDescriptor(context, &current);
+        JS_SetQtScriptPropertyUndeletable(context, state->runtimeGlobal,
+                                          it->atom, false);
+        JS_DeleteProperty(context, state->runtimeGlobal, it->atom, 0);
+        discardQuickJSException(context);
+        if (it->hadPrevious)
+            defineGlobalDescriptor(context, state->runtimeGlobal, it->atom,
+                                   &it->previous);
+        JS_FreeValue(context, it->previous.value);
+        JS_FreeValue(context, it->previous.getter);
+        JS_FreeValue(context, it->previous.setter);
+        JS_FreeAtom(context, it->atom);
+    }
+    if (hasCallException) {
+        JS_Throw(context, callException);
+        callException = JS_UNDEFINED;
+    }
+    return result;
+}
+
+static bool valueMatchesOwnProperty(JSContext *context, JSValueConst object,
+                                    JSValueConst value)
+{
+    if (!context || !JS_IsObject(object))
+        return false;
+    JSPropertyEnum *properties = nullptr;
+    uint32_t count = 0;
+    if (JS_GetOwnPropertyNames(context, &properties, &count, object,
+                               JS_GPN_STRING_MASK) < 0) {
+        discardQuickJSException(context);
+        return false;
+    }
+    bool matches = false;
+    for (uint32_t index = 0; index < count && !matches; ++index) {
+        JSPropertyDescriptor descriptor{};
+        if (JS_GetOwnProperty(context, &descriptor, object,
+                              properties[index].atom) > 0) {
+            if (!(descriptor.flags & JS_PROP_GETSET))
+                matches = JS_IsStrictEqual(context, descriptor.value, value);
+            freeQuickJSDescriptor(context, &descriptor);
+        } else {
+            discardQuickJSException(context);
+        }
+    }
+    JS_FreePropertyEnum(context, properties, count);
+    return matches;
+}
+
+static bool valueMatchesContextScope(QScriptEngineState *state,
+                                     QScriptContext *context,
+                                     JSValueConst value)
+{
+    if (!state || !context || !JS_IsFunction(state->context, value))
+        return false;
+    const QScriptValueList scopes = context->scopeChain();
+    for (const QScriptValue &scopeValue : scopes) {
+        bool scopeOk = false;
+        JSValue scope = QScriptEnginePrivate::get(state->engine)->toQuickJS(
+            scopeValue, &scopeOk);
+        if (scopeOk && valueMatchesOwnProperty(state->context, scope, value)) {
+            JS_FreeValue(state->context, scope);
+            return true;
+        }
+        JS_FreeValue(state->context, scope);
+    }
+    return false;
+}
+
+static JSValue wrapFunctionWithScope(JSContext *context, JSValueConst function,
+                                     JSValueConst scope)
+{
+    JSValue capturedScope = JS_NewObject(context);
+    if (JS_IsException(capturedScope))
+        return capturedScope;
+    JSPropertyEnum *properties = nullptr;
+    uint32_t count = 0;
+    if (JS_GetOwnPropertyNames(context, &properties, &count, scope,
+                               JS_GPN_STRING_MASK) < 0) {
+        JS_FreeValue(context, capturedScope);
+        return JS_EXCEPTION;
+    }
+    bool captureFailed = false;
+    for (uint32_t index = 0; index < count; ++index) {
+        if (JS_DefinePropertyValue(context, capturedScope, properties[index].atom,
+                                   JS_UNDEFINED,
+                                   JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE) < 0) {
+            captureFailed = true;
+            break;
+        }
+    }
+    JS_FreePropertyEnum(context, properties, count);
+    if (captureFailed) {
+        JS_FreeValue(context, capturedScope);
+        return JS_EXCEPTION;
+    }
+    JSValue data[] = { function, scope, capturedScope };
+    JSValue wrapper = JS_NewCFunctionData(context, scopedFunctionThunk, 0, 0, 3, data);
+    JS_FreeValue(context, capturedScope);
+    if (!JS_IsException(wrapper))
+        JS_DefinePropertyValueStr(context, wrapper, "__qt_scope__",
+                                  JS_DupValue(context, scope),
+                                  JS_PROP_CONFIGURABLE | JS_PROP_WRITABLE);
+    return wrapper;
 }
 
