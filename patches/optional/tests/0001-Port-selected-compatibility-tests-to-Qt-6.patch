-        QCOMPARE(ret.isVariant(), true);
+        QCOMPARE(ret.isNumber(), true);
+        QCOMPARE(ret.toInt32(), int(MyQObject::BazPolicy));
     }
     m_myObject->resetQtFunctionInvoked();
     {
