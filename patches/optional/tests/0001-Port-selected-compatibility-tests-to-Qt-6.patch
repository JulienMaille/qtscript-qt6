         QCOMPARE(m_myObject->qtFunctionInvoked(), 49);
     }
 
-    // first time we expect failure because the metatype is not registered
+    // Qt 6 moc embeds the return metatype even before global registration.
+    // Without a script sequence converter it is exposed as a QVariant.
