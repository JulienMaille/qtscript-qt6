From c26df84a35fce1f75a6c428e2ea57a1eb5aac5b6 Mon Sep 17 00:00:00 2001
From: codex <codex@local.invalid>
Date: Wed, 12 Aug 2026 12:39:00 +0200
Subject: [PATCH] Modernize RegExp duplicate-flag handling

---
 tests/auto/qscriptengine/tst_qscriptengine.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tests/auto/qscriptengine/tst_qscriptengine.cpp b/tests/auto/qscriptengine/tst_qscriptengine.cpp
index ffbb21f..cf4954e 100644
--- a/tests/auto/qscriptengine/tst_qscriptengine.cpp
+++ b/tests/auto/qscriptengine/tst_qscriptengine.cpp
@@ -658,10 +658,10 @@ void tst_QScriptEngine::jsRegExp()
     QVERIFY(r7.isError());
     QVERIFY(r7.toString().contains(QString::fromLatin1("SyntaxError"))); // Invalid regular expression flag
 
-    // JSC doesn't complain about duplicate flags.
+    // Duplicate flags are rejected by the standard RegExp grammar.
     QScriptValue r8 = eng.evaluate("/foo/migmigmig");
-    QVERIFY(r8.isRegExp());
-    QCOMPARE(r8.toString(), QString::fromLatin1("/foo/gim"));
+    QVERIFY(r8.isError());
+    QVERIFY(r8.toString().contains(QString::fromLatin1("SyntaxError")));
 
     QScriptValue r9 = rxCtor.construct();
     QVERIFY(r9.isRegExp());
-- 
