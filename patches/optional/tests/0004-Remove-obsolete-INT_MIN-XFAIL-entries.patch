From b2a52f9a1ecd628002052849ebf3ad229a9a42e0 Mon Sep 17 00:00:00 2001
From: QtScript Qt 6 patch set <qtscript-qt6@local.invalid>
Date: Sun, 9 Aug 2026 11:48:33 +0200
Subject: [PATCH] Drop obsolete INT_MIN expected-failure entries

The negate opcode now promotes INT32_MIN negation to the double 2^31
(core patch 0008), so the MSVC64 and MINGW64 XFAIL entries for
QTBUG-32829 are obsolete: -(-2147483648) == 2147483648 now passes on
every toolchain.
---
 tests/auto/qscriptjstestsuite/expect_fail.txt | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/tests/auto/qscriptjstestsuite/expect_fail.txt b/tests/auto/qscriptjstestsuite/expect_fail.txt
index 6fedd4a..532aa10 100644
--- a/tests/auto/qscriptjstestsuite/expect_fail.txt
+++ b/tests/auto/qscriptjstestsuite/expect_fail.txt
@@ -136,10 +136,6 @@ ecma_3/Expressions/11.7.3-01.js | 11.7.3 - >>> should evaluate operands in order
 ecma_3/Operators/order-01.js | operator evaluation order: 11.7.3 >>> | QTBUG-8056
 ecma_3/Operators/order-01.js | operator evaluation order: 11.13.2 >>>= | QTBUG-8056
 
-[Q_CC_MSVC64]
-ecma/Expressions/11.4.7-02.js | -(-2147483648) == 2147483648 | QTBUG-32829
-ecma/TypeConversion/9.3.1-3.js | - -"0x80000000" | QTBUG-32829
-
 [Q_CC_MINGW]
 ecma/Math/15.8.2.5.js | Math.atan2(Infinity, Infinity)
 ecma/Math/15.8.2.5.js | Math.atan2(Infinity, -Infinity)
@@ -148,10 +144,6 @@ ecma/Math/15.8.2.5.js | Math.atan2(-Infinity, -Infinity)
 ecma/Math/15.8.2.17.js | Math.sqrt(-0)
 ecma/Math/15.8.2.17.js | Infinity/Math.sqrt(-0)
 
-[Q_CC_MINGW64]
-ecma/Expressions/11.4.7-02.js | -(-2147483648) == 2147483648 | QTBUG-32829
-ecma/TypeConversion/9.3.1-3.js | - -"0x80000000" | QTBUG-32829
-
 [Q_OS_SOLARIS]
 ecma/Expressions/11.13.2-2.js | VAR1 = -0; VAR2= Infinity; VAR2 /= VAR1
 ecma/Expressions/11.13.2-2.js | VAR1 = -0; VAR2= -Infinity; VAR2 /= VAR1
