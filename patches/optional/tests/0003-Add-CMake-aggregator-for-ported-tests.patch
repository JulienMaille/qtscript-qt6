From f9161ddf14b35cf9bb243f3b44fd92ae6f305f8e Mon Sep 17 00:00:00 2001
From: Julien Maille <julien.maille@data-pixel.com>
Date: Sun, 9 Aug 2026 01:30:00 +0200
Subject: [PATCH] Add CMake aggregator for the ported test suites

qt_build_repo_impl_tests only descends into tests/ when a
tests/CMakeLists.txt exists, so the qmake-only test tree produced no
ctest targets. Add an aggregator plus per-suite CMakeLists.txt for the
six ported suites. Tests link the in-repo Qt6::Script module; the engine
suite also consumes Qt6::ScriptPrivate for its private-header include
path, and the GUI suites link Qt6::Widgets. The Qt 5-era
tests/auto/cmake/CMakeLists.txt (find_package(Qt5Core)) is removed.
---
 tests/CMakeLists.txt                         |  6 +++++
 tests/auto/cmake/CMakeLists.txt              | 24 --------------------
 tests/auto/qscriptcontext/CMakeLists.txt     |  2 ++
 tests/auto/qscriptengine/CMakeLists.txt      |  6 +++++
 tests/auto/qscriptextqobject/CMakeLists.txt  |  3 +++
 tests/auto/qscriptjstestsuite/CMakeLists.txt |  5 ++++
 tests/auto/qscriptv8testsuite/CMakeLists.txt |  4 ++++
 tests/auto/qscriptvalue/CMakeLists.txt       |  3 +++
 8 files changed, 29 insertions(+), 24 deletions(-)
 create mode 100644 tests/CMakeLists.txt
 delete mode 100644 tests/auto/cmake/CMakeLists.txt
 create mode 100644 tests/auto/qscriptcontext/CMakeLists.txt
 create mode 100644 tests/auto/qscriptengine/CMakeLists.txt
 create mode 100644 tests/auto/qscriptextqobject/CMakeLists.txt
 create mode 100644 tests/auto/qscriptjstestsuite/CMakeLists.txt
 create mode 100644 tests/auto/qscriptv8testsuite/CMakeLists.txt
 create mode 100644 tests/auto/qscriptvalue/CMakeLists.txt

diff --git a/tests/auto/cmake/CMakeLists.txt b/tests/auto/cmake/CMakeLists.txt
deleted file mode 100644
index 82dd5ef..0000000
--- a/tests/auto/cmake/CMakeLists.txt
+++ /dev/null
@@ -1,24 +0,0 @@
-
-cmake_minimum_required(VERSION 2.8)
-
-project(qmake_cmake_files)
-
-enable_testing()
-
-find_package(Qt5Core REQUIRED)
-
-include("${_Qt5CTestMacros}")
-
-set(qt_module_includes
-    Script QScriptEngine
-)
-
-if (NOT NO_WIDGETS)
-    list(APPEND qt_module_includes
-        ScriptTools QScriptEngineDebugger
-    )
-endif()
-
-test_module_includes(
-    ${qt_module_includes}
-)
