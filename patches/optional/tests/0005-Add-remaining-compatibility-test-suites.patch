From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julien Maille <julien.maille@data-pixel.com>
Date: Sun, 9 Aug 2026 02:00:00 +0200
Subject: [PATCH] Add remaining QtScript compatibility test suites

Wire the seven standalone QtScript compatibility suites that were still
qmake-only into the Qt 6 test build. The extension-plugin test keeps both
the dynamic and static plugin cases; the dynamic plugin is copied to the
test data directory because QFINDTESTDATA resolves the legacy plugins/script
layout. The widget test links Qt6::Widgets.

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 0cd128f..30eb356 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -4,3 +4,10 @@ add_subdirectory(auto/qscriptextqobject)
 add_subdirectory(auto/qscriptjstestsuite)
 add_subdirectory(auto/qscriptv8testsuite)
 add_subdirectory(auto/qscriptvalue)
+add_subdirectory(auto/qscriptclass)
+add_subdirectory(auto/qscriptstring)
+add_subdirectory(auto/qscriptvalueiterator)
+add_subdirectory(auto/qscriptextensionplugin)
+add_subdirectory(auto/qscriptable)
+add_subdirectory(auto/qscriptcontextinfo)
+add_subdirectory(auto/qscriptqwidgets)
diff --git a/tests/auto/qscriptclass/CMakeLists.txt b/tests/auto/qscriptclass/CMakeLists.txt
new file mode 100644
index 0000000..c9a4e5f
--- /dev/null
+++ b/tests/auto/qscriptclass/CMakeLists.txt
@@ -0,0 +1,2 @@
+qt_internal_add_test(tst_qscriptclass SOURCES tst_qscriptclass.cpp)
+target_link_libraries(tst_qscriptclass PRIVATE Qt6::Script)
diff --git a/tests/auto/qscriptstring/CMakeLists.txt b/tests/auto/qscriptstring/CMakeLists.txt
new file mode 100644
index 0000000..c9a4e5f
--- /dev/null
+++ b/tests/auto/qscriptstring/CMakeLists.txt
@@ -0,0 +1,2 @@
+qt_internal_add_test(tst_qscriptstring SOURCES tst_qscriptstring.cpp)
+target_link_libraries(tst_qscriptstring PRIVATE Qt6::Script)
diff --git a/tests/auto/qscriptvalueiterator/CMakeLists.txt b/tests/auto/qscriptvalueiterator/CMakeLists.txt
new file mode 100644
index 0000000..c9a4e5f
--- /dev/null
+++ b/tests/auto/qscriptvalueiterator/CMakeLists.txt
@@ -0,0 +1,2 @@
+qt_internal_add_test(tst_qscriptvalueiterator SOURCES tst_qscriptvalueiterator.cpp)
+target_link_libraries(tst_qscriptvalueiterator PRIVATE Qt6::Script)
diff --git a/tests/auto/qscriptextensionplugin/CMakeLists.txt b/tests/auto/qscriptextensionplugin/CMakeLists.txt
new file mode 100644
index 0000000..8f5a6d3
--- /dev/null
+++ b/tests/auto/qscriptextensionplugin/CMakeLists.txt
@@ -0,0 +1,40 @@
+qt_add_plugin(simplePlugin
+    MODULE
+    OUTPUT_NAME simpleplugin
+    PLUGIN_TYPE script
+    CLASS_NAME SimplePlugin
+    simpleplugin/simpleplugin.cpp
+)
+target_link_libraries(simplePlugin PRIVATE Qt6::Script)
+set_target_properties(simplePlugin PROPERTIES
+    AUTOMOC ON
+    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/plugins/script"
+    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/plugins/script"
+)
+foreach(config Debug Release)
+    set_target_properties(simplePlugin PROPERTIES
+        LIBRARY_OUTPUT_DIRECTORY_${config} "${CMAKE_CURRENT_BINARY_DIR}/plugins/script"
+        RUNTIME_OUTPUT_DIRECTORY_${config} "${CMAKE_CURRENT_BINARY_DIR}/plugins/script"
+    )
+endforeach()
+add_custom_command(TARGET simplePlugin POST_BUILD
+    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/plugins/script"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+        "$<TARGET_FILE:simplePlugin>"
+        "${CMAKE_CURRENT_BINARY_DIR}/plugins/script/$<TARGET_FILE_NAME:simplePlugin>"
+)
+
+qt6_add_resources(staticPluginResources staticplugin/staticplugin.qrc)
+qt_add_plugin(staticPlugin
+    STATIC
+    OUTPUT_NAME staticplugin
+    PLUGIN_TYPE script
+    CLASS_NAME StaticPlugin
+    staticplugin/staticplugin.cpp ${staticPluginResources}
+)
+target_link_libraries(staticPlugin PRIVATE Qt6::Script)
+set_target_properties(staticPlugin PROPERTIES AUTOMOC ON)
+
+qt_internal_add_test(tst_qscriptextensionplugin SOURCES tst_qscriptextensionplugin.cpp)
+target_link_libraries(tst_qscriptextensionplugin PRIVATE Qt6::Script staticPlugin)
+add_dependencies(tst_qscriptextensionplugin simplePlugin)
